---
import "../styles/global.css";
import { siteDescription, siteName, siteOgImage } from "../data/site";
import { getSessionContext } from "../lib/session";

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = siteDescription,
  currentPath = "/",
  image = siteOgImage,
  noindex = false,
} = Astro.props;

const { isAdmin } = await getSessionContext(Astro.request);

const navigation = [
  { href: "/", label: "Inicio" },
  { href: "/resultados", label: "Resultados" },
  { href: "/bracket", label: "Llaves" },
  { href: "/groups", label: "Grupos" },
  { href: "/companions", label: "Compañeros" },
  { href: "/groups#reglas", label: "Reglas" },
  ...(isAdmin ? [{ href: "/admin/results", label: "Admin" }] : []),
];

const pageTitle = `${title} | ${siteName}`;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImageURL = image ? new URL(image, Astro.site ?? Astro.url).toString() : undefined;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: siteName,
      description,
      url: canonicalURL?.toString() ?? Astro.url.toString(),
      inLanguage: "es",
    },
    {
      "@type": "WebPage",
      name: pageTitle,
      description,
      url: canonicalURL?.toString() ?? Astro.url.toString(),
      isPartOf: {
        "@type": "WebSite",
        name: siteName,
      },
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Ubuntu:wght@400;500;700&display=swap" rel="stylesheet" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="theme-color" content="#08111f" />
    {canonicalURL && <link rel="canonical" href={canonicalURL.toString()} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL?.toString() ?? Astro.url.toString()} />
    {socialImageURL && <meta property="og:image" content={socialImageURL} />}
    {socialImageURL && <meta property="og:image:alt" content="Vista previa del juego de pronósticos del Mundial 2026" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImageURL && <meta name="twitter:image" content={socialImageURL} />}
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/">
          <span class="brand-mark">⚽</span>
          <span class="brand-copy">
            <span>{siteName}</span>
          </span>
        </a>

        <nav class="nav-links" aria-label="Principal">
          {navigation.map((item) => (
            <a
              href={item.href}
              aria-current={currentPath === item.href ? "page" : undefined}
              class={item.href === "/admin/results" ? "nav-link-admin" : undefined}
            >
              {item.label}
            </a>
          ))}
          <span class="auth-nav-slot" data-auth-slot></span>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <p>{siteName} · Fixture oficial de fase de grupos 2026 armado sobre datos de FIFA y horarios mostrados para Chile.</p>
        <div class="list-inline">
          <a href="/resultados">Resultados</a>
          <a href="/bracket">Llaves</a>
          <a href="/companions">Compañeros</a>
          <a href="/groups#grupos">Planilla completa</a>
          <a href="/groups#reglas">Reglas</a>
        </div>
      </div>
    </footer>

    <script>
      import { getSupabaseBrowserClient } from "../lib/supabase";

      (async function () {
        const slot = document.querySelector("[data-auth-slot]");
        if (!slot) return;

        const renderLoginLink = () => {
          slot.innerHTML = `<a class="button nav-cta" href="/api/auth/signin" data-login-button>Iniciar sesión con Google</a>`;
          const loginButton = slot.querySelector("[data-login-button]");
          if (!loginButton) return;

          loginButton.addEventListener("click", async (event) => {
            event.preventDefault();

            try {
              const supabase = getSupabaseBrowserClient();
              await supabase.auth.signInWithOAuth({
                provider: "google",
                options: {
                  redirectTo: `${window.location.origin}/api/auth/callback`,
                },
              });
            } catch {
              window.location.href = "/api/auth/signin";
            }
          });
        };

        try {
          const res = await fetch("/api/auth/session");
          const data = await res.json();

          if (data.ok && data.user) {
            const rankingBadge = Number.isInteger(data.rankingPosition)
              ? `<span class="auth-rank-badge" title="Posición actual en el ranking">#${data.rankingPosition}</span>`
              : "";
            const adminBadge = data.isAdmin
              ? `<span class="auth-admin-badge" title="Administrador">Admin</span>`
              : "";
            slot.innerHTML = `
              <span class="auth-user-pill">
                <img src="${data.user.avatar}" alt="" width="24" height="24" class="auth-avatar" referrerpolicy="no-referrer" />
                <span class="auth-user-name">${data.user.name || data.user.email}</span>
                ${rankingBadge}
                ${adminBadge}
              </span>
              <form method="POST" action="/api/auth/signout" style="display:inline">
                <button type="submit" class="button-secondary nav-cta">Cerrar sesión</button>
              </form>
            `;
          } else {
            renderLoginLink();
          }
        } catch {
          renderLoginLink();
        }
      })();
    </script>
  </body>
</html>
