---
import Layout from "../../layouts/Layout.astro";
import { groupedMatches } from "../../data/site";
import { knockoutFixturesByPhase } from "../../data/knockout";
---

<Layout
  title="Resultados Reales"
  currentPath="/admin/results"
  description="Ingresa los resultados reales de los partidos del Mundial 2026."
  noindex={true}
>
  <main class="page-section">
    <div class="site-shell">
      <div class="table-row-head">
        <div>
          <span class="eyebrow">Administración</span>
          <h1 class="page-title">Resultados Reales</h1>
        </div>
      </div>

      <p class="section-copy">Ingresa los resultados reales de cada partido. Los puntajes se calcularán automáticamente para todos los jugadores.</p>

      <div class="save-dock">
        <div class="save-dock-top">
          <div class="progress-pill">
            <span class="muted">Partidos con resultado:</span>
            <strong id="results-count">0</strong> <span class="muted">/ <span id="total-matches"></span></span>
          </div>
          <div class="inline-actions">
            <button type="button" class="button-secondary" id="sync-fifa-btn">Actualizar desde FIFA</button>
            <button type="button" class="button" id="save-results-btn" disabled>Guardar resultados</button>
          </div>
        </div>
      </div>

      <div class="groups-grid" id="results-groups"></div>
      <div class="groups-grid" id="results-knockout" style="margin-top:1.5rem"></div>

      <p id="save-status" class="save-status" aria-live="polite"></p>
    </div>
  </main>

  <script is:inline define:vars={{ groupedMatchesJson: JSON.stringify(groupedMatches), knockoutPhasesJson: JSON.stringify(knockoutFixturesByPhase) }}>
    const groupedMatches = JSON.parse(groupedMatchesJson);
    const knockoutPhases = JSON.parse(knockoutPhasesJson);

    function escapeHtml(value) {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#39;");
    }

    function flagCodePoints(flag) {
      return Array.from(flag || "🏳️")
        .map((char) => char.codePointAt(0).toString(16))
        .join("-");
    }

    function resolveFlagValue(flag, teamOrLabel = "") {
      const team = String(teamOrLabel).replace(/^Favorito:\s*/, "").trim();
      if (team === "Inglaterra") return "\u{1F3F4}\u{E0067}\u{E0062}\u{E0065}\u{E006E}\u{E0067}\u{E007F}";
      if (team === "Escocia") return "\u{1F3F4}\u{E0067}\u{E0062}\u{E0073}\u{E0063}\u{E0074}\u{E007F}";
      return flag || "🏳️";
    }

    function flagWithLabel(flag, label) {
      return `<span class="flag-inline"><img class="flag-icon" src="https://cdnjs.cloudflare.com/ajax/libs/twemoji/14.0.2/svg/${flagCodePoints(resolveFlagValue(flag, label))}.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" /><span>${escapeHtml(label)}</span></span>`;
    }

    const groupsContainer = document.getElementById("results-groups");
    const knockoutContainer = document.getElementById("results-knockout");
    const syncBtn = document.getElementById("sync-fifa-btn");
    const saveBtn = document.getElementById("save-results-btn");
    const resultsCount = document.getElementById("results-count");
    const totalMatchesEl = document.getElementById("total-matches");
    const saveStatus = document.getElementById("save-status");

    let hasUnsavedChanges = false;

    function updateResultsCount() {
      let count = 0;
      let total = 0;
      groupedMatches.forEach((group) => {
        group.matches.forEach((match) => {
          total++;
          const homeInput = document.getElementById(`${match.id}-home`);
          const awayInput = document.getElementById(`${match.id}-away`);
          if (homeInput && awayInput && homeInput.value !== "" && awayInput.value !== "") {
            count++;
          }
        });
      });
      knockoutPhases.forEach((phase) => {
        phase.matches.forEach((match) => {
          total++;
          const homeInput = document.getElementById(`ko-${match.id}-home-score`);
          const awayInput = document.getElementById(`ko-${match.id}-away-score`);
          if (homeInput && awayInput && homeInput.value !== "" && awayInput.value !== "") {
            count++;
          }
        });
      });
      if (resultsCount) resultsCount.textContent = count;
      if (totalMatchesEl) totalMatchesEl.textContent = total;
      hasUnsavedChanges = count > 0;
      if (saveBtn) saveBtn.disabled = !hasUnsavedChanges;
    }

    function createMatchRow(match, hasResult) {
      const homeId = `${match.id}-home`;
      const awayId = `${match.id}-away`;
      const hasHome = hasResult && hasResult.home_result !== null && hasResult.home_result !== undefined;
      const hasAway = hasResult && hasResult.away_result !== null && hasResult.away_result !== undefined;
      const homeValue = hasHome ? hasResult.home_result : "";
      const awayValue = hasAway ? hasResult.away_result : "";
      const hasResultFlag = hasHome || hasAway;

      return `
        <div class="simple-match-card" data-match-id="${match.id}" ${hasResultFlag ? 'data-has-result="true"' : ''}>
          <div class="simple-match-main">
            <div class="simple-teams">
              <span>${flagWithLabel(match.homeFlag, match.home)}</span>
              <span class="muted">vs</span>
              <span>${flagWithLabel(match.awayFlag, match.away)}</span>
            </div>
            <div class="simple-score-entry">
              <input
                type="number"
                min="0"
                max="20"
                class="input-like"
                id="${homeId}"
                value="${homeValue}"
                placeholder="—"
                aria-label="Goles ${match.home}"
                inputmode="numeric"
                minlength="1"
                maxlength="2"
              >
              <span class="muted">—</span>
              <input
                type="number"
                min="0"
                max="20"
                class="input-like"
                id="${awayId}"
                value="${awayValue}"
                placeholder="—"
                aria-label="Goles ${match.away}"
                inputmode="numeric"
                minlength="1"
                maxlength="2"
              >
            </div>
          </div>
          <div class="simple-match-footer">
            <span class="muted small-note">${match.kickoffChile} · ${match.venue}, ${match.city}</span>
            ${hasResultFlag ? '<span class="tag success">Resultado guardado</span>' : ''}
          </div>
        </div>
      `;
    }

    function renderGroups(matchesWithResults = {}) {
      if (!groupsContainer) return;
      groupsContainer.innerHTML = groupedMatches.map((group, idx) => `
        <details class="group-card group-collapsible" ${idx < 2 ? "open" : ""}>
          <summary class="group-head">
            <div class="group-head-main">
              <span class="group-tag tag">Grupo ${group.group}</span>
              <h3 class="section-title-compact">Grupo ${group.group}</h3>
            </div>
          </summary>
          <div class="simple-match-list">
            ${group.matches.map((match) => createMatchRow(match, matchesWithResults[match.id])).join("")}
          </div>
        </details>
      `).join("");

      attachInputListeners();
      updateResultsCount();
    }

    function createKnockoutRow(match, saved = {}) {
      const homeTeam = saved.home_team || match.homeSlot;
      const awayTeam = saved.away_team || match.awaySlot;
      const homeValue = Number.isInteger(saved.home_result) ? saved.home_result : "";
      const awayValue = Number.isInteger(saved.away_result) ? saved.away_result : "";
      const penaltiesWinner = saved.penalties_winner || "";

      return `
        <div class="simple-match-card" data-knockout-id="${match.id}">
          <div class="simple-match-main simple-match-main--stack">
            <strong>${escapeHtml(match.label)}</strong>
            <div class="muted small-note">${new Date(match.kickoffAt).toLocaleString("es-CL", { timeZone: "Etc/GMT+4", day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit", hour12: false })} · ${escapeHtml(match.venue)}, ${escapeHtml(match.city)}</div>
            <div class="knockout-admin-team-grid">
              <input class="input-like" id="ko-${match.id}-home-team" value="${escapeHtml(homeTeam)}" placeholder="${escapeHtml(match.homeSlot)}" />
              <input class="input-like" id="ko-${match.id}-home-score" type="number" min="0" max="20" value="${homeValue}" placeholder="—" inputmode="numeric" />
              <span class="muted">-</span>
              <input class="input-like" id="ko-${match.id}-away-score" type="number" min="0" max="20" value="${awayValue}" placeholder="—" inputmode="numeric" />
              <input class="input-like" id="ko-${match.id}-away-team" value="${escapeHtml(awayTeam)}" placeholder="${escapeHtml(match.awaySlot)}" />
            </div>
            <select class="input-like" id="ko-${match.id}-pens">
              <option value="">Ganador por penales (si empatan)</option>
              <option value="home" ${penaltiesWinner === "home" ? "selected" : ""}>${escapeHtml(homeTeam)}</option>
              <option value="away" ${penaltiesWinner === "away" ? "selected" : ""}>${escapeHtml(awayTeam)}</option>
            </select>
          </div>
        </div>`;
    }

    function renderKnockout(savedMatches = {}) {
      if (!knockoutContainer) return;
      knockoutContainer.innerHTML = knockoutPhases.map((phase, idx) => `
        <details class="group-card group-collapsible" ${idx < 2 ? "open" : ""}>
          <summary class="group-head">
            <div class="group-head-main">
              <span class="group-tag tag">${phase.label}</span>
              <h3 class="section-title-compact">${phase.label}</h3>
            </div>
          </summary>
          <div class="simple-match-list">
            ${phase.matches.map((match) => createKnockoutRow(match, savedMatches[match.id])).join("")}
          </div>
        </details>
      `).join("");

      attachInputListeners();
      updateResultsCount();
    }

    function attachInputListeners() {
      document.querySelectorAll('.simple-match-card input[type="number"]').forEach((input) => {
        input.addEventListener("input", () => {
          const val = input.value;
          if (val !== "" && (parseInt(val, 10) < 0 || parseInt(val, 10) > 20)) {
            input.setCustomValidity("Debe ser entre 0 y 20");
          } else {
            input.setCustomValidity("");
          }
          input.reportValidity();
          updateResultsCount();
          hasUnsavedChanges = true;
          if (saveBtn) saveBtn.disabled = false;
        });

        input.addEventListener("change", () => {
          updateResultsCount();
        });
      });
    }

    async function loadResults() {
      try {
        const res = await fetch("/api/admin/results");
        const data = await res.json();
        if (data.ok) {
          renderGroups(data.results || {});
          renderKnockout(data.knockoutResults || {});
        } else {
          renderGroups();
          renderKnockout();
        }
      } catch {
        renderGroups();
        renderKnockout();
      }
    }

    async function saveResults() {
      if (!saveBtn) return;
      saveBtn.disabled = true;
      saveBtn.textContent = "Guardando...";
      if (saveStatus) saveStatus.textContent = "Guardando resultados...";

      const results = {};
      const knockoutResults = {};
      groupedMatches.forEach((group) => {
        group.matches.forEach((match) => {
          const homeInput = document.getElementById(`${match.id}-home`);
          const awayInput = document.getElementById(`${match.id}-away`);
          const homeVal = homeInput?.value?.trim();
          const awayVal = awayInput?.value?.trim();
          if (homeVal !== "" && awayVal !== "") {
            results[match.id] = {
              home_result: parseInt(homeVal, 10),
              away_result: parseInt(awayVal, 10),
            };
          }
        });
      });

      knockoutPhases.forEach((phase) => {
        phase.matches.forEach((match) => {
          const homeTeam = document.getElementById(`ko-${match.id}-home-team`)?.value?.trim() || match.homeSlot;
          const awayTeam = document.getElementById(`ko-${match.id}-away-team`)?.value?.trim() || match.awaySlot;
          const homeVal = document.getElementById(`ko-${match.id}-home-score`)?.value?.trim() ?? "";
          const awayVal = document.getElementById(`ko-${match.id}-away-score`)?.value?.trim() ?? "";
          const penaltiesWinner = document.getElementById(`ko-${match.id}-pens`)?.value || null;
          knockoutResults[match.id] = {
            home_team: homeTeam,
            away_team: awayTeam,
            home_result: homeVal === "" ? null : parseInt(homeVal, 10),
            away_result: awayVal === "" ? null : parseInt(awayVal, 10),
            penalties_winner: penaltiesWinner,
          };
        });
      });

      try {
        const res = await fetch("/api/admin/results", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ results, knockoutResults }),
        });
        const data = await res.json();
        if (data.ok) {
          if (saveStatus) saveStatus.textContent = `✓ ${data.updated} resultados guardados`;
          hasUnsavedChanges = false;
          loadResults();
        } else {
          if (saveStatus) saveStatus.textContent = `Error: ${data.error}`;
          saveBtn.disabled = false;
          saveBtn.textContent = "Guardar resultados";
        }
      } catch {
        if (saveStatus) saveStatus.textContent = "Error de red al guardar";
        saveBtn.disabled = false;
        saveBtn.textContent = "Guardar resultados";
      }
    }

    async function syncFromFifa() {
      if (!syncBtn) return;

      syncBtn.disabled = true;
      syncBtn.textContent = "Actualizando...";
      if (saveStatus) saveStatus.textContent = "Consultando resultados oficiales en FIFA...";

      try {
        const res = await fetch("/api/admin/results/fifa-sync", {
          method: "POST",
        });
        const data = await res.json();

        if (!data.ok) {
          if (saveStatus) saveStatus.textContent = `Error FIFA: ${data.error}`;
          return;
        }

        const suspiciousNote = Array.isArray(data.suspiciousGroups) && data.suspiciousGroups.length > 0
          ? ` Atención: ${data.suspiciousGroups.join(" ")}`
          : "";

        if (saveStatus) {
          saveStatus.textContent = `✓ FIFA importó ${data.imported} resultado(s) y actualizó ${data.updated} partido(s).${suspiciousNote}`;
        }

        hasUnsavedChanges = false;
        await loadResults();
      } catch {
        if (saveStatus) saveStatus.textContent = "Error de red al consultar FIFA";
      } finally {
        syncBtn.disabled = false;
        syncBtn.textContent = "Actualizar desde FIFA";
      }
    }

    if (saveBtn) {
      saveBtn.addEventListener("click", saveResults);
    }

    if (syncBtn) {
      syncBtn.addEventListener("click", syncFromFifa);
    }

    loadResults();
  </script>
</Layout>
