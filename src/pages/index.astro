---
import Layout from "../layouts/Layout.astro";
import { groupedMatches, scoringExamples, scoringRules } from "../data/site";
import { getFlag } from "../lib/flags";

const totalMatches = groupedMatches.reduce((sum, group) => sum + group.matches.length, 0);
const allTeams = [...new Set(groupedMatches.flatMap((g) => g.matches.flatMap((m) => [m.home, m.away])))].sort();
const teamFlags: Record<string, string> = {};
allTeams.forEach((t) => { teamFlags[t] = getFlag(t); });
---

<Layout
  title="Inicio"
  currentPath="/"
  description="Pronósticos del Mundial 2026: juega con tus amigos, elige tu país favorito y compite con puntaje por exactos y ganador o empate."
>
  <div class="simple-main">
    <section class="simple-top" aria-labelledby="hero-title">
      <div class="site-shell simple-stack">
        <div class="hero-copy-block">
          <span class="eyebrow">Pronósticos del Mundial 2026</span>
          <h1 class="simple-title" id="hero-title">Juega con tus amigos: cargá tus pronósticos y compará resultados al instante.</h1>
          <p class="section-copy">Los 72 partidos de fase de grupos del Mundial FIFA 2026, con horarios para Chile, sedes y banderas. Elegí tu equipo favorito, ingresá tus marcadores y competí con tus compañeros en una planilla simple y transparente.</p>
        </div>

        <div class="summary-grid">
          <article class="summary-box highlight" data-player-summary>
            <div class="muted">Jugador</div>
            <strong data-player-name-display>Inicia sesión para jugar</strong>
            <span data-player-fav-display class="muted">Ingresa con Google para cargar tus pronósticos</span>
          </article>
          <article class="summary-box">
            <div class="muted">Grupos</div>
            <strong>12</strong>
          </article>
          <article class="summary-box">
            <div class="muted">Partidos</div>
            <strong>72</strong>
          </article>
          <article class="summary-box">
            <div class="muted">TV Chile</div>
            <strong>DSPORTS + DGO</strong>
          </article>
        </div>

        <div class="inline-actions" style="margin-top:1rem">
          <a class="button" href="/companions">Ver compañeros y pronósticos</a>
        </div>
      </div>
    </section>

    <!-- Auth gate: prompt to sign in -->
    <section class="page-section simple-section" data-auth-gate style="display:none">
      <div class="site-shell">
        <article class="panel auth-gate-panel">
          <div class="auth-gate-inner">
            <span class="eyebrow">Acceso requerido</span>
            <h2 class="section-title">Inicia sesión para jugar</h2>
            <p class="muted" style="margin-bottom:1.2rem">Necesitás una cuenta de Google para guardar tus pronósticos y que queden persistidos.</p>
            <a class="button" href="/api/auth/signin" data-login-gate-button>Iniciar sesión con Google</a>
          </div>
        </article>
      </div>
    </section>

    <section class="page-section simple-section workspace-section" data-workspace-section style="display:none">
      <div class="site-shell workspace-grid workspace-grid-duo">
        <article class="panel workspace-column workspace-entry" id="grupos" aria-labelledby="grupos-title">
          <div class="save-dock" aria-label="Controles de guardado">
            <div class="save-dock-top">
              <div>
                <span class="eyebrow">Planilla activa</span>
                <h2 class="section-title" id="grupos-title">Ingreso de partidos</h2>
              </div>
              <div class="progress-pill">Progreso: <strong data-progress-count>0/{totalMatches}</strong> partidos completos</div>
            </div>

            <p class="save-status" data-save-status role="status">Cargando datos del servidor...</p>

            <div class="lock-banner" data-lock-banner style="display:none" role="alert">
              <span class="lock-banner-icon">🔒</span>
              <span class="lock-banner-text" data-lock-banner-text></span>
            </div>

            <div class="inline-actions">
              <button class="button" type="button" data-save-all>Guardar todo</button>
              <button class="button-secondary" type="button" data-clear-all>Limpiar</button>
            </div>
          </div>

          <article class="panel panel-entry">
            <div class="table-row-head">
              <div>
                <span class="eyebrow">Ingresa pronósticos</span>
                <h3 class="entry-title">Planilla completa de grupos A–L</h3>
              </div>
              <span class="muted">Horario Chile · sede · DSPORTS / DGO</span>
            </div>

            <div class="groups-grid groups-grid-single">
              {groupedMatches.map((group, idx) => (
                <details class="group-card group-collapsible" open={idx < 2}>
                  <summary class="group-head">
                    <div class="group-head-main">
                      <span class="tag group-tag">Grupo {group.group}</span>
                      <h3>{group.matches.length} partidos</h3>
                    </div>
                  </summary>

                  <div class="group-table-wrap">
                    <table class="prediction-table">
                      <caption class="visually-hidden">Pronósticos del grupo {group.group} con marcador, horario de Chile y sede.</caption>
                      <thead>
                        <tr>
                          <th>Partido</th>
                          <th>Resultado</th>
                          <th>Chile</th>
                          <th>Sede</th>
                        </tr>
                      </thead>
                      <tbody>
                        {group.matches.map((match) => (
                          <tr data-match-row={match.id}>
                            <td>
                              <div class="fixture-cell">
                                <span>{match.homeFlag} {match.home}</span>
                                <span class="muted">vs</span>
                                <span>{match.awayFlag} {match.away}</span>
                              </div>
                            </td>
                            <td>
                              <div class="score-inputs">
                                <input type="number" min="0" max="20" inputmode="numeric" placeholder="" data-score-input data-match={match.id} data-side="home" aria-label={`Resultado ${match.home}`} disabled />
                                <span>-</span>
                                <input type="number" min="0" max="20" inputmode="numeric" placeholder="" data-score-input data-match={match.id} data-side="away" aria-label={`Resultado ${match.away}`} disabled />
                              </div>
                            </td>
                            <td>{match.kickoffChile}</td>
                            <td>
                              <strong>{match.venue}</strong>
                              <div class="muted">{match.city}</div>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </details>
              ))}
            </div>
          </article>
        </article>

        <article class="panel compact-panel workspace-column workspace-rules" id="reglas" aria-labelledby="reglas-title">
          <span class="eyebrow">Reglas oficiales</span>
          <h2 class="section-title section-title-compact" id="reglas-title">Puntaje</h2>

          <div class="rules-highlight">
            <p><strong>Reglamento corto:</strong></p>
            <ul>
              <li><strong>5 puntos</strong> si aciertas el marcador exacto.</li>
              <li><strong>3 puntos</strong> si aciertas ganador o empate, aunque no sea exacto.</li>
              <li><strong>+1 punto</strong> si juega tu equipo favorito y ese pronóstico ya sumó puntos.</li>
              <li><strong>0 puntos</strong> si fallas el signo del partido.</li>
            </ul>
          </div>

          <div class="rules-box">
            {scoringRules.map((rule) => (
              <div class="rule-line">
                <strong>{rule.points}</strong>
                <span>{rule.title}</span>
              </div>
            ))}
          </div>

          <div class="examples-box">
            <p class="examples-title">Ejemplos con partidos reales del fixture</p>
            {scoringExamples.map((item) => (
              <div class="example-line">
                <strong>{item.points}</strong>
                <div>
                  <div>{item.title}</div>
                  <span class="muted">{item.example}</span>
                </div>
              </div>
            ))}
          </div>

          <p class="fair-note">Estas reglas se aplican igual para todos los jugadores y buscan que el juego sea simple, claro y fácil de revisar.</p>
        </article>
      </div>
    </section>
  </div>

    <!-- Companions / Players Section -->
    <section class="page-section simple-section" data-companions-section style="display:none">
      <div class="site-shell">
        <article class="panel">
          <div class="table-row-head">
            <div>
              <span class="eyebrow">Compañeros</span>
              <h2 class="section-title">Quiénes ya jugaron</h2>
            </div>
            <span class="muted" data-companions-count></span>
          </div>

          <div class="ranking-list" data-companions-list>
            <p class="muted">Cargando compañeros...</p>
          </div>
        </article>
      </div>
    </section>

    <!-- Player Detail Modal -->
    <div class="modal-overlay" data-player-modal style="display:none">
      <div class="modal-card modal-card-wide">
        <div class="player-dialog-head">
          <div>
            <span class="eyebrow">Pronósticos de</span>
            <h2 class="section-title" data-player-modal-name></h2>
            <span class="muted" data-player-modal-fav></span>
          </div>
          <button type="button" class="button-secondary dialog-close" data-player-modal-close>Cerrar</button>
        </div>

        <div class="player-predictions-grid" data-player-predictions-content>
          <p class="muted">Cargando pronósticos...</p>
        </div>
      </div>
    </div>

    <!-- Favorite Team Modal (shown on first authenticated login) -->
  <div class="modal-overlay" data-fav-modal style="display:none">
    <div class="modal-card">
      <span class="eyebrow">Tu equipo favorito</span>
      <h2 class="section-title">Elige tu país favorito</h2>
      <p class="muted" style="margin-bottom:1rem">Este equipo recibirá +1 punto extra en cada pronóstico acertado donde juegue.</p>

      <div class="fav-warning">
        <strong>⚠️ Atención:</strong> Tu país favorito quedará fijado y <strong>no podrás cambiarlo después</strong>. Esta decisión es <strong>irreversible</strong>. Asegúrate de elegir correctamente antes de confirmar.
      </div>

      <form data-fav-form>
        <div class="fav-grid">
          {allTeams.map((team) => (
            <label class="fav-option">
              <input type="radio" name="favorite_team" value={team} />
              <span class="fav-option-flag">{teamFlags[team]}</span>
              <span>{team}</span>
            </label>
          ))}
        </div>

        <div class="inline-actions" style="margin-top:1.2rem">
          <button type="submit" class="button" data-fav-confirm disabled>Confirmar favorito</button>
        </div>
      </form>

      <p class="muted" style="margin-top:.75rem" data-fav-status role="status"></p>
    </div>
  </div>

  <!-- Favorite Locked State Modal (shown when favorite is already set) -->
  <div class="modal-overlay" data-fav-locked-modal style="display:none">
    <div class="modal-card">
      <span class="eyebrow">Tu equipo favorito</span>
      <h2 class="section-title">Equipo favorito fijado</h2>

      <div class="fav-locked-state">
        <div class="fav-locked-flag" data-locked-flag-display></div>
        <div class="fav-locked-name" data-locked-team-display></div>
        <div class="fav-locked-badge">🔒 No se puede cambiar</div>
      </div>

      <div class="fav-warning" style="margin-top:1rem">
        <strong>Recordatorio:</strong> Tu país favorito fue elegido en tu primer ingreso y es <strong>irreversible</strong>. Cada pronóstico acertado donde juegue este equipo suma +1 punto extra.
      </div>

      <div class="inline-actions" style="margin-top:1rem">
        <button type="button" class="button" data-fav-locked-close>Entendido</button>
      </div>
    </div>
  </div>

  <script is:inline>
    const STORAGE_KEY = "mundial-2026-player-id";
    const FIRST_MATCH_KICKOFF = new Date("2026-06-11T15:00:00-04:00"); // Chile time (UTC-4)
    const LOCK_CUTOFF = new Date(FIRST_MATCH_KICKOFF.getTime() - 60 * 60 * 1000); // 1 hour before
    const inputs = Array.from(document.querySelectorAll("[data-score-input]"));
    const progressNode = document.querySelector("[data-progress-count]");
    const saveButton = document.querySelector("[data-save-all]");
    const clearButton = document.querySelector("[data-clear-all]");
    const saveStatus = document.querySelector("[data-save-status]");
    const playerNameDisplay = document.querySelector("[data-player-name-display]");
    const playerFavDisplay = document.querySelector("[data-player-fav-display]");
    const authGate = document.querySelector("[data-auth-gate]");
    const workspaceSection = document.querySelector("[data-workspace-section]");
    const favModal = document.querySelector("[data-fav-modal]");
    const favForm = document.querySelector("[data-fav-form]");
    const favConfirm = document.querySelector("[data-fav-confirm]");
    const favStatus = document.querySelector("[data-fav-status]");
    const favLockedModal = document.querySelector("[data-fav-locked-modal]");
    const lockedFlagDisplay = document.querySelector("[data-locked-flag-display]");
    const lockedTeamDisplay = document.querySelector("[data-locked-team-display]");
    const favLockedClose = document.querySelector("[data-fav-locked-close]");
    const lockBanner = document.querySelector("[data-lock-banner]");
    const lockBannerText = document.querySelector("[data-lock-banner-text]");

    var currentPlayerId = null;
    var serverPlayer = null;
    var sessionUser = null;

    // ---- helpers ----

    function getPlayerId() {
      let id = localStorage.getItem(STORAGE_KEY);
      if (!id) {
        id = crypto.randomUUID();
        localStorage.setItem(STORAGE_KEY, id);
      }
      return id;
    }

    function announce(msg) {
      if (saveStatus) saveStatus.textContent = msg;
    }

    function isLocked() {
      return new Date() >= LOCK_CUTOFF;
    }

    function applyLockState() {
      if (isLocked()) {
        setInputsDisabled(true);
        if (lockBanner) {
          lockBanner.style.display = "";
          const unlockDate = FIRST_MATCH_KICKOFF.toLocaleString("es-CL", { timeZone: "America/Santiago", dateStyle: "long", timeStyle: "short" });
          if (lockBannerText) lockBannerText.textContent = `Los pronósticos se bloquearon el ${unlockDate} (1 hora antes del primer partido). Ya no se pueden modificar.`;
        }
      }
    }

    function setInputsDisabled(disabled) {
      const forceDisable = isLocked();
      inputs.forEach((input) => {
        input.disabled = disabled || forceDisable;
      });
      if (saveButton) saveButton.disabled = disabled || forceDisable;
      if (clearButton) clearButton.disabled = disabled || forceDisable;
    }

    // ---- session & bootstrap ----

    async function checkSession() {
      try {
        const res = await fetch("/api/auth/session");
        const data = await res.json();
        if (data.ok && data.user) {
          sessionUser = data.user;
          return data.user;
        }
      } catch {}
      return null;
    }

    function updateProgress() {
      const matchIds = new Set(inputs.map((i) => i.dataset.match));
      let completed = 0;
      matchIds.forEach((id) => {
        const h = document.querySelector(`[data-score-input][data-match="${id}"][data-side="home"]`);
        const a = document.querySelector(`[data-score-input][data-match="${id}"][data-side="away"]`);
        if (h && a && h.value !== "" && a.value !== "") completed += 1;
      });
      if (progressNode) progressNode.textContent = `${completed}/${matchIds.size}`;
    }

    function hydratePredictions(predictions) {
      inputs.forEach((input) => {
        input.value = "";
      });

      predictions.forEach((p) => {
        const homeInput = document.querySelector(`[data-score-input][data-match="${p.match_id}"][data-side="home"]`);
        const awayInput = document.querySelector(`[data-score-input][data-match="${p.match_id}"][data-side="away"]`);
        if (homeInput && Number.isFinite(p.home_score)) homeInput.value = String(p.home_score);
        if (awayInput && Number.isFinite(p.away_score)) awayInput.value = String(p.away_score);
      });
      updateProgress();
    }

    function updatePlayerDisplay(player) {
      if (!player) return;
      if (playerNameDisplay) {
        playerNameDisplay.textContent = player.name || sessionUser?.name || "Sin nombre";
      }
      if (playerFavDisplay) {
        if (player.favorite_team) {
          playerFavDisplay.textContent = `${player.favorite_flag || '🏳️'} Favorito: ${player.favorite_team}`;
        } else {
          playerFavDisplay.textContent = "Elegí tu equipo favorito para completar tu perfil";
        }
      }
    }

    function showFavModal() {
      if (favModal) favModal.style.display = "";
    }

    function hideFavModal() {
      if (favModal) favModal.style.display = "none";
    }

    function showFavLockedModal(flag, team) {
      if (lockedFlagDisplay) lockedFlagDisplay.textContent = flag || "🏳️";
      if (lockedTeamDisplay) lockedTeamDisplay.textContent = team || "No definido";
      if (favLockedModal) favLockedModal.style.display = "";
    }

    function hideFavLockedModal() {
      if (favLockedModal) favLockedModal.style.display = "none";
    }

    // ---- save ----

    async function saveAllPredictions() {
      if (!currentPlayerId) {
        announce("Error: no hay sesión de jugador.");
        return;
      }

      const predictions = [];
      const matchIds = new Set(inputs.map((i) => i.dataset.match));

      matchIds.forEach((matchId) => {
        const h = document.querySelector(`[data-score-input][data-match="${matchId}"][data-side="home"]`);
        const a = document.querySelector(`[data-score-input][data-match="${matchId}"][data-side="away"]`);
        if (h && a && h.value !== "" && a.value !== "") {
          const homeScore = h.valueAsNumber;
          const awayScore = a.valueAsNumber;

          if (!Number.isInteger(homeScore) || !Number.isInteger(awayScore)) {
            return;
          }

          predictions.push({
            match_id: matchId,
            home_score: homeScore,
            away_score: awayScore,
          });
        }
      });

      try {
        const res = await fetch("/api/predictions", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ player_id: currentPlayerId, predictions }),
        });
        const data = await res.json();
        if (data.ok) {
          announce(`Pronósticos guardados (${data.saved} partidos).`);
          await bootstrap();
          await loadCompanions();
        } else {
          announce(`Error al guardar: ${data.error}`);
        }
      } catch (err) {
        announce("Error de red al guardar.");
      }

      updateProgress();
    }

    async function clearPredictions() {
      if (!currentPlayerId) return;

      try {
        const res = await fetch("/api/predictions", {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ player_id: currentPlayerId }),
        });
        const data = await res.json();
        if (data.ok) {
          inputs.forEach((input) => (input.value = ""));
          updateProgress();
          announce("Pronósticos borrados.");
          await bootstrap();
          await loadCompanions();
        }
      } catch {
        announce("Error de red al borrar.");
      }
    }

    async function saveFavoriteTeam(team) {
      try {
        const res = await fetch("/api/auth/favorite-team", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ favorite_team: team }),
        });
        const data = await res.json();
        if (data.ok) {
          serverPlayer = data.player;
          hideFavModal();
          await bootstrap();
        } else {
          if (favStatus) favStatus.textContent = `Error: ${data.error}`;
        }
      } catch {
        if (favStatus) favStatus.textContent = "Error de red al guardar favorito.";
      }
    }

    async function bootstrap() {
      const user = await checkSession();

      if (!user) {
        // Not authenticated — show auth gate, hide workspace
        if (authGate) authGate.style.display = "";
        if (workspaceSection) workspaceSection.style.display = "none";
        setInputsDisabled(true);
        if (playerNameDisplay) playerNameDisplay.textContent = "Inicia sesión para jugar";
        if (playerFavDisplay) playerFavDisplay.textContent = "Ingresa con Google para cargar tus pronósticos";
        return;
      }

      // Authenticated — hide auth gate, show workspace
      if (authGate) authGate.style.display = "none";
      if (workspaceSection) workspaceSection.style.display = "";
      setInputsDisabled(false);

      applyLockState();

      currentPlayerId = user.id;

      try {
        const res = await fetch(`/api/bootstrap?player_id=${encodeURIComponent(currentPlayerId)}`);
        const data = await res.json();

        if (data.ok) {
          serverPlayer = data.player;
          updatePlayerDisplay(data.player);
          hydratePredictions(data.predictions);
          announce("Datos cargados desde el servidor.");

          if (sessionUser && data.player && !data.player.favorite_team) {
            // First login — show favourite-team picker
            showFavModal();
          }
        } else {
          announce("Error al cargar datos del servidor.");
        }
      } catch {
        announce("Error de red al cargar datos.");
      }
    }

    // ---- events ----

    inputs.forEach((input) => input.addEventListener("input", updateProgress));
    if (saveButton) saveButton.addEventListener("click", saveAllPredictions);
    if (clearButton) clearButton.addEventListener("click", clearPredictions);

    // Favorite-team modal
    if (favForm) {
      favForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const selected = favForm.querySelector("input[name=favorite_team]:checked");
        if (!selected) return;
        await saveFavoriteTeam(selected.value);
      });
      favForm.querySelectorAll("input[name=favorite_team]").forEach((radio) => {
        radio.addEventListener("change", () => {
          if (favConfirm) favConfirm.disabled = false;
        });
      });
    }

    // Favorite locked modal close
    if (favLockedClose) {
      favLockedClose.addEventListener("click", hideFavLockedModal);
    }

    // ---- companions ----

    const companionsSection = document.querySelector("[data-companions-section]");
    const companionsList = document.querySelector("[data-companions-list]");
    const companionsCount = document.querySelector("[data-companions-count]");
    const playerModal = document.querySelector("[data-player-modal]");
    const playerModalName = document.querySelector("[data-player-modal-name]");
    const playerModalFav = document.querySelector("[data-player-modal-fav]");
    const playerModalClose = document.querySelector("[data-player-modal-close]");
    const playerPredictionsContent = document.querySelector("[data-player-predictions-content]");

    function hidePlayerModal() {
      if (playerModal) playerModal.style.display = "none";
    }

    if (playerModalClose) {
      playerModalClose.addEventListener("click", hidePlayerModal);
    }
    if (playerModal) {
      playerModal.addEventListener("click", (e) => {
        if (e.target === playerModal) hidePlayerModal();
      });
    }

    async function loadCompanions() {
      try {
        const res = await fetch("/api/players");
        const data = await res.json();

        if (!data.ok) {
          console.error("[companions] API error:", data.error);
          if (companionsSection) companionsSection.style.display = "";
          if (companionsList) companionsList.innerHTML = '<p class="muted">No se pudo cargar la lista de compañeros.</p>';
          return;
        }

        const currentPlayerRecordId = serverPlayer?.id ?? null;
        let allPlayers = [...(data.players || [])];

        if (currentPlayerRecordId) {
          const alreadyIncluded = allPlayers.some((p) => p.id === currentPlayerRecordId);
          if (!alreadyIncluded && serverPlayer) {
            allPlayers.unshift({
              id: serverPlayer.id,
              name: serverPlayer.name || sessionUser?.name || "Sin nombre",
              favorite_team: serverPlayer.favorite_team || null,
              favorite_flag: serverPlayer.favorite_flag || "🏳️",
              predictions_count: 0,
              joined: null,
            });
          }
        }

        if (allPlayers.length === 0) {
          if (companionsSection) companionsSection.style.display = "none";
          return;
        }

        if (companionsSection) companionsSection.style.display = "";

        if (!companionsList) return;

        if (companionsCount) companionsCount.textContent = `${allPlayers.length} jugador${allPlayers.length !== 1 ? "es" : ""}`;

        companionsList.innerHTML = allPlayers
          .map(
            (p) => {
              const isCurrentUser = currentPlayerRecordId && p.id === currentPlayerRecordId;
              return `
          <div class="ranking-item companion-card" data-player-id="${p.id}" tabindex="0" role="button" aria-label="Ver pronósticos de ${p.name}">
            <div class="ranking-main">
              <div class="ranking-identity">
                <div class="ranking-position">${p.favorite_flag || '🏳️'}</div>
                <div>
                  <div class="ranking-name">${p.name || 'Sin nombre'} ${isCurrentUser ? '<span class="tag success">Tú</span>' : ''}</div>
                  ${p.favorite_team ? `<div class="ranking-favorite">Favorito: ${p.favorite_team}</div>` : '<div class="ranking-favorite muted">Sin favorito</div>'}
                </div>
              </div>
              <div class="ranking-points-block">
                <span class="ranking-points">${p.predictions_count || 0}</span>
                <span class="ranking-points-label">pronósticos</span>
              </div>
            </div>
          </div>
        `;
            }
          )
          .join("");

        companionsList.querySelectorAll(".companion-card").forEach((card) => {
          const handler = () => openPlayerDetail(card.dataset.playerId);
          card.addEventListener("click", handler);
          card.addEventListener("keydown", (e) => {
            if (e.key === "Enter" || e.key === " ") {
              e.preventDefault();
              handler();
            }
          });
        });
      } catch (err) {
        console.error("[companions] Failed to load:", err);
        if (companionsSection) companionsSection.style.display = "";
        if (companionsList) companionsList.innerHTML = '<p class="muted">Error de red al cargar compañeros.</p>';
      }
    }

    async function openPlayerDetail(playerId) {
      if (!playerModal || !playerModalName || !playerPredictionsContent) return;

      playerModal.style.display = "";
      playerModalName.textContent = "Cargando...";
      if (playerModalFav) playerModalFav.textContent = "";
      playerPredictionsContent.innerHTML = '<p class="muted">Cargando pronósticos...</p>';

      try {
        const res = await fetch(`/api/players?id=${encodeURIComponent(playerId)}`);
        const data = await res.json();

        if (!data.ok) {
          playerPredictionsContent.innerHTML = '<p class="muted">No se pudo cargar la información.</p>';
          return;
        }

        playerModalName.textContent = data.player.name;
        if (playerModalFav) {
          playerModalFav.textContent = data.player.favorite_team
            ? `${data.player.favorite_flag} Favorito: ${data.player.favorite_team}`
            : "Sin equipo favorito";
        }

        if (!data.predictions || data.predictions.length === 0) {
          playerPredictionsContent.innerHTML = '<p class="muted">Este jugador aún no ha cargado pronósticos.</p>';
          return;
        }

        const grouped = {};
        data.predictions.forEach((pred) => {
          const group = pred.match_id.charAt(0);
          if (!grouped[group]) grouped[group] = [];
          grouped[group].push(pred);
        });

        const allMatches = {};
        {groupedMatches.forEach((g) => {
          g.matches.forEach((m) => { allMatches[m.id] = m; });
        });}

        let html = "";
        const sortedGroups = Object.keys(grouped).sort();

        sortedGroups.forEach((group) => {
          const preds = grouped[group];
          html += `<div class="player-group-card">
            <h4 class="eyebrow" style="margin-bottom:.5rem">Grupo ${group}</h4>
            <div class="readonly-list">`;

          preds.forEach((pred) => {
            const match = allMatches[pred.match_id];
            if (!match) return;
            html += `
              <div class="readonly-row">
                <div class="fixture-cell" style="min-width:auto">
                  <span>${match.homeFlag} ${match.home}</span>
                  <span class="muted">vs</span>
                  <span>${match.awayFlag} ${match.away}</span>
                </div>
                <div class="readonly-score">
                  <span class="readonly-pill">${pred.home_score}</span>
                  <span class="muted">-</span>
                  <span class="readonly-pill">${pred.away_score}</span>
                </div>
              </div>`;
          });

          html += `</div></div>`;
        });

        playerPredictionsContent.innerHTML = html;
      } catch {
        playerPredictionsContent.innerHTML = '<p class="muted">Error de red al cargar.</p>';
      }
    }

    (async () => {
      await bootstrap();
      await loadCompanions();
    })();
  </script>
</Layout>
