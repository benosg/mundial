---
import Layout from "../layouts/Layout.astro";
import { dashboardStats, groupedMatches, quickSummary, ranking, sampleUser, scoringExamples, scoringRules } from "../data/site";

const totalMatches = groupedMatches.reduce((sum, group) => sum + group.matches.length, 0);

const createDemoPredictions = (playerName: string) => {
  const seed = [...playerName].reduce((sum, char) => sum + char.charCodeAt(0), 0);

  return groupedMatches.map((group, groupIndex) => ({
    group: group.group,
    matches: group.matches.map((match, matchIndex) => {
      const base = seed + groupIndex * 7 + matchIndex * 11;
      const home = base % 4;
      const away = (base + playerName.length + match.id.length) % 4;

      return {
        ...match,
        homePrediction: home,
        awayPrediction: away,
      };
    }),
  }));
};

const playerBoards = ranking.map((player) => ({
  name: player.name,
  favorite: player.favorite,
  predictions: createDemoPredictions(player.name),
}));
---

<Layout
  title="Inicio"
  currentPath="/"
  description="Pronósticos del Mundial 2026: juega con tus amigos, elige tu país favorito y compite con puntaje por exactos y ganador o empate."
>
  <div class="simple-main">
    <section class="simple-top" aria-labelledby="hero-title">
      <div class="site-shell simple-stack">
        <div class="hero-copy-block">
          <span class="eyebrow">Grupo privado · Mundial 2026</span>
          <h1 class="simple-title" id="hero-title">Carga toda la fase de grupos en una sola planilla.</h1>
          <p class="section-copy">Todos los partidos reales de FIFA 2026, con hora Chile, sede y banderas. Pensado para llenar rápido, comparar amigos y revisar cada pronóstico con transparencia.</p>
          <div class="hero-badges" aria-label="Resumen rápido del producto">
            <span class="hero-badge">72 partidos reales</span>
            <span class="hero-badge">Horario Chile</span>
            <span class="hero-badge">Bonus por favorito</span>
          </div>
        </div>

        <div class="summary-grid">
          <article class="summary-box highlight">
            <div class="muted">Jugador</div>
            <strong>{sampleUser.name}</strong>
            <span>{sampleUser.favoriteFlag} Favorito: {sampleUser.favoriteTeam}</span>
          </article>
          {quickSummary.map((item) => (
            <article class="summary-box">
              <div class="muted">{item.label}</div>
              <strong>{item.value}</strong>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="page-section simple-section workspace-section">
      <div class="site-shell workspace-grid">
        <article class="panel workspace-column workspace-ranking" id="tabla" aria-labelledby="tabla-title">
          <div class="table-row-head">
            <div>
              <span class="eyebrow">Cómo vamos</span>
              <h2 class="section-title" id="tabla-title">Tabla del grupo</h2>
            </div>
            <div class="table-actions">
              <span class="tag success">Haz click en un nombre</span>
              <span class="muted small-note">Se abre en una ventana aparte</span>
            </div>
          </div>

          <table>
            <caption class="visually-hidden">Tabla de posiciones del grupo con puntos, exactos, aciertos y avance de cada jugador.</caption>
            <thead>
              <tr>
                <th>#</th>
                <th>Jugador</th>
                <th>Favorito</th>
                <th>Puntos</th>
                <th>Exactos</th>
                <th>Aciertos</th>
                <th>Completados</th>
              </tr>
            </thead>
            <tbody>
              {ranking.map((player) => (
                <tr>
                  <td class="rank">{player.position}</td>
                  <td>
                    <button class="name-button" type="button" data-player-button={player.name} data-player-controls={`panel-${player.name}`} aria-controls={`panel-${player.name}`} aria-pressed={player.name === sampleUser.name ? "true" : "false"}>
                      {player.name}
                    </button>
                  </td>
                  <td>{player.favorite}</td>
                  <td>{player.points}</td>
                  <td>{player.exact}</td>
                  <td>{player.outcomes}</td>
                  <td>{player.completed}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </article>

        <article class="workspace-column workspace-entry" id="grupos" aria-labelledby="grupos-title">
          <div class="panel save-dock" aria-label="Controles de guardado">
            <div class="save-dock-top">
              <div>
                <span class="eyebrow">Planilla activa</span>
                <h2 class="section-title" id="grupos-title">Ingreso de partidos</h2>
              </div>
              <div class="progress-pill">Progreso: <strong data-progress-count>0/{totalMatches}</strong> partidos completos</div>
            </div>

            <p class="save-status" data-save-status role="status" aria-live="polite">Tus cambios se guardan en este navegador.</p>

            <div class="inline-actions">
              <button class="button" type="button" data-save-all>Guardar todo</button>
              <button class="button-secondary" type="button" data-clear-all>Limpiar</button>
            </div>
          </div>

          <article class="panel panel-entry">
            <div class="table-row-head">
              <div>
                <span class="eyebrow">Ingresa pronósticos</span>
                <h3 class="entry-title">Planilla completa de grupos A–L</h3>
              </div>
              <span class="muted">Horario Chile · sede · DSPORTS / DGO</span>
            </div>

            <div class="groups-grid groups-grid-single">
              {groupedMatches.map((group) => (
                <article class="group-card">
                  <div class="group-head">
                    <div>
                      <span class="eyebrow">Grupo {group.group}</span>
                      <h3>6 partidos</h3>
                    </div>
                    <span class="tag">Fase de grupos</span>
                  </div>

                  <div class="group-table-wrap">
                    <table class="prediction-table">
                      <caption class="visually-hidden">Pronósticos del grupo {group.group} con marcador, horario de Chile y sede.</caption>
                      <thead>
                        <tr>
                          <th>Partido</th>
                          <th>Resultado</th>
                          <th>Chile</th>
                          <th>Sede</th>
                        </tr>
                      </thead>
                      <tbody>
                        {group.matches.map((match) => (
                          <tr>
                            <td>
                              <div class="fixture-cell">
                                <span>{match.homeFlag} {match.home}</span>
                                <span class="muted">vs</span>
                                <span>{match.awayFlag} {match.away}</span>
                              </div>
                            </td>
                            <td>
                              <div class="score-inputs">
                                <input type="number" min="0" max="20" inputmode="numeric" placeholder="0" data-score-input data-match={match.id} data-side="home" aria-label={`Resultado ${match.home}`} />
                                <span>-</span>
                                <input type="number" min="0" max="20" inputmode="numeric" placeholder="0" data-score-input data-match={match.id} data-side="away" aria-label={`Resultado ${match.away}`} />
                              </div>
                            </td>
                            <td>{match.kickoffChile}</td>
                            <td>
                              <strong>{match.venue}</strong>
                              <div class="muted">{match.city}</div>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </article>
              ))}
            </div>
          </article>
        </article>

        <article class="panel compact-panel workspace-column workspace-rules" id="reglas" aria-labelledby="reglas-title">
          <span class="eyebrow">Reglas oficiales</span>
          <h2 class="section-title" id="reglas-title">Puntaje claro y transparente para todo el grupo</h2>
          <div class="compact-stats">
            {dashboardStats.map((stat) => (
              <div class="compact-stat">
                <strong>{stat.value}</strong>
                <span>{stat.label}</span>
              </div>
            ))}
          </div>

          <div class="source-note">
            Datos base de fixture: <strong>FIFA Scores & Fixtures</strong><br />
            Horarios vistos con territorio <strong>Chile</strong>.<br />
            Transmisión mostrada por FIFA: <strong>DSPORTS</strong> y <strong>DGO</strong>.
          </div>

          <div class="rules-highlight">
            <p><strong>Reglamento corto:</strong></p>
            <ul>
              <li><strong>5 puntos</strong> si aciertas el marcador exacto.</li>
              <li><strong>3 puntos</strong> si aciertas ganador o empate, aunque no sea exacto.</li>
              <li><strong>+1 punto</strong> si juega tu equipo favorito y ese pronóstico ya sumó puntos.</li>
              <li><strong>0 puntos</strong> si fallas el signo del partido.</li>
            </ul>
          </div>

          <div class="rules-box">
            {scoringRules.map((rule) => (
              <div class="rule-line">
                <strong>{rule.points}</strong>
                <span>{rule.title}</span>
              </div>
            ))}
          </div>

          <div class="examples-box">
            <p class="examples-title">Ejemplos con partidos reales del fixture</p>
            {scoringExamples.map((item) => (
              <div class="example-line">
                <strong>{item.points}</strong>
                <div>
                  <div>{item.title}</div>
                  <span class="muted">{item.example}</span>
                </div>
              </div>
            ))}
          </div>

          <p class="fair-note">Estas reglas se aplican igual para todos los jugadores y buscan que el juego sea simple, claro y fácil de revisar.</p>
        </article>
      </div>
    </section>
  </div>

  <dialog class="player-dialog" data-player-dialog aria-labelledby="player-dialog-title">
    <div class="player-dialog-shell">
      <div class="player-dialog-head">
        <div>
          <span class="eyebrow">Transparencia</span>
          <h2 class="section-title" id="player-dialog-title">Pronósticos cargados por cada jugador</h2>
          <p class="muted">Vista separada del ingreso principal · solo lectura</p>
        </div>
        <button class="button-secondary dialog-close" type="button" data-close-player-dialog>Cerrar</button>
      </div>

      <div class="player-panels">
        {playerBoards.map((player, playerIndex) => (
          <article class={`player-panel ${playerIndex === 0 ? "is-active" : ""}`} id={`panel-${player.name}`} data-player-panel={player.name} aria-label={`Pronósticos de ${player.name}`} hidden={playerIndex !== 0}>
            <div class="player-panel-head">
              <div>
                <span class="eyebrow">Jugador seleccionado</span>
                <h3>{player.name}</h3>
                <p class="muted">Favorito: {player.favorite}</p>
              </div>
              <span class="tag">Solo lectura</span>
            </div>

            <div class="player-groups-grid">
              {player.predictions.map((group) => (
                <section class="player-group-card" aria-label={`Grupo ${group.group} de ${player.name}`}>
                  <div class="group-head compact">
                    <div>
                      <span class="eyebrow">Grupo {group.group}</span>
                      <h4>6 pronósticos</h4>
                    </div>
                  </div>

                  <div class="readonly-list">
                    {group.matches.map((match) => (
                      <div class="readonly-row">
                        <div class="fixture-cell">
                          <span>{match.homeFlag} {match.home}</span>
                          <span class="muted">vs</span>
                          <span>{match.awayFlag} {match.away}</span>
                        </div>
                        <div class="readonly-score">
                          <span class="readonly-pill" data-readonly-score={player.name === sampleUser.name ? `${match.id}-home` : undefined}>{match.homePrediction}</span>
                          <span class="muted">-</span>
                          <span class="readonly-pill" data-readonly-score={player.name === sampleUser.name ? `${match.id}-away` : undefined}>{match.awayPrediction}</span>
                        </div>
                      </div>
                    ))}
                  </div>
                </section>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </dialog>

  <script is:inline>
    const STORAGE_KEY = "mundial-2026-picks";
    const inputs = Array.from(document.querySelectorAll("[data-score-input]"));
    const progressNode = document.querySelector("[data-progress-count]");
    const saveButton = document.querySelector("[data-save-all]");
    const clearButton = document.querySelector("[data-clear-all]");
    const saveStatus = document.querySelector("[data-save-status]");
    const playerDialog = document.querySelector("[data-player-dialog]");
    const closePlayerDialogButton = document.querySelector("[data-close-player-dialog]");
    const playerButtons = Array.from(document.querySelectorAll("[data-player-button]"));
    const playerPanels = Array.from(document.querySelectorAll("[data-player-panel]"));

    const announce = (message) => {
      if (saveStatus) saveStatus.textContent = message;
    };

    const readScores = () => {
      try {
        return JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}");
      } catch {
        return {};
      }
    };

    const writeScores = (scores) => {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(scores));
    };

    const updateProgress = () => {
      const matches = new Set(inputs.map((input) => input.dataset.match));
      let completed = 0;

      matches.forEach((matchId) => {
        const home = document.querySelector(`[data-score-input][data-match="${matchId}"][data-side="home"]`);
        const away = document.querySelector(`[data-score-input][data-match="${matchId}"][data-side="away"]`);

        if (home && away && home.value !== "" && away.value !== "") {
          completed += 1;
        }
      });

      if (progressNode) progressNode.textContent = `${completed}/${matches.size}`;
    };

    const hydrate = () => {
      const scores = readScores();
      inputs.forEach((input) => {
        const key = `${input.dataset.match}-${input.dataset.side}`;
        if (scores[key] !== undefined) input.value = scores[key];
      });
      updateProgress();
      announce(Object.keys(scores).length ? "Pronósticos recuperados desde este navegador." : "Tus cambios se guardan en este navegador.");
    };

    const persist = () => {
      const scores = {};
      inputs.forEach((input) => {
        const key = `${input.dataset.match}-${input.dataset.side}`;
        if (input.value !== "") scores[key] = input.value;
      });
      writeScores(scores);
      updateProgress();
      updateReadonlyCurrentUser(scores);
      announce("Pronósticos guardados localmente.");
    };

    const updateReadonlyCurrentUser = (scores = readScores()) => {
      const readonlyNodes = Array.from(document.querySelectorAll("[data-readonly-score]"));
      readonlyNodes.forEach((node) => {
        const key = node.dataset.readonlyScore;
        if (!key) return;
        node.textContent = scores[key] ?? "-";
      });
    };

    const showPlayerPanel = (playerName) => {
      playerPanels.forEach((panel) => {
        const active = panel.dataset.playerPanel === playerName;
        panel.hidden = !active;
        panel.classList.toggle("is-active", active);
      });

      playerButtons.forEach((button) => {
        const active = button.dataset.playerButton === playerName;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", active ? "true" : "false");
      });

      announce(`Viendo pronósticos de ${playerName}.`);
    };

    const openPlayerDialog = (playerName) => {
      showPlayerPanel(playerName);
      if (playerDialog && !playerDialog.open) playerDialog.showModal();
    };

    const closePlayerDialog = () => {
      if (playerDialog?.open) playerDialog.close();
    };

    inputs.forEach((input) => input.addEventListener("input", persist));
    playerButtons.forEach((button) => {
      button.addEventListener("click", () => openPlayerDialog(button.dataset.playerButton));
    });
    if (saveButton) saveButton.addEventListener("click", persist);
    if (closePlayerDialogButton) closePlayerDialogButton.addEventListener("click", closePlayerDialog);
    if (playerDialog) {
      playerDialog.addEventListener("click", (event) => {
        const rect = playerDialog.getBoundingClientRect();
        const inside = rect.top <= event.clientY && event.clientY <= rect.top + rect.height && rect.left <= event.clientX && event.clientX <= rect.left + rect.width;
        if (!inside) closePlayerDialog();
      });
    }
    if (clearButton) {
      clearButton.addEventListener("click", () => {
        localStorage.removeItem(STORAGE_KEY);
        inputs.forEach((input) => (input.value = ""));
        updateProgress();
        updateReadonlyCurrentUser({});
        announce("Pronósticos borrados de este navegador.");
      });
    }

    hydrate();
    updateReadonlyCurrentUser();
    showPlayerPanel("Beno");
  </script>
</Layout>
