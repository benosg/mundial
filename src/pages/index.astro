---
import Layout from "../layouts/Layout.astro";
import { dashboardStats, matches, quickSummary, ranking, sampleUser, scoringRules } from "../data/site";
---

<Layout
  title="Inicio"
  currentPath="/"
  description="Pronósticos del Mundial 2026: juega con tus amigos, elige tu país favorito y compite con puntaje por exactos y ganador o empate."
>
  <main class="simple-main">
    <section class="simple-top">
      <div class="site-shell simple-stack">
        <div>
          <span class="eyebrow">Grupo privado · Mundial 2026</span>
          <h1 class="simple-title">Ingresa tus resultados y mira cómo van todos.</h1>
          <p class="section-copy">Sin vueltas: tabla arriba, partidos abajo, todo claro y con banderas.</p>
        </div>

        <div class="summary-grid">
          <article class="summary-box highlight">
            <div class="muted">Jugador</div>
            <strong>{sampleUser.name}</strong>
            <span>{sampleUser.favoriteFlag} Favorito: {sampleUser.favoriteTeam}</span>
          </article>
          {quickSummary.map((item) => (
            <article class="summary-box">
              <div class="muted">{item.label}</div>
              <strong>{item.value}</strong>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="page-section simple-section">
      <div class="site-shell simple-grid">
        <article class="panel">
          <div class="table-row-head">
            <div>
              <span class="eyebrow">Cómo vamos</span>
              <h2 class="section-title">Tabla del grupo</h2>
            </div>
            <span class="tag success">Todos</span>
          </div>

          <table>
            <thead>
              <tr>
                <th>#</th>
                <th>Jugador</th>
                <th>Favorito</th>
                <th>Puntos</th>
                <th>Exactos</th>
                <th>Aciertos</th>
              </tr>
            </thead>
            <tbody>
              {ranking.map((player) => (
                <tr>
                  <td class="rank">{player.position}</td>
                  <td>{player.name}</td>
                  <td>{player.favorite}</td>
                  <td>{player.points}</td>
                  <td>{player.exact}</td>
                  <td>{player.outcomes}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </article>

        <article class="panel compact-panel">
          <span class="eyebrow">Tu resumen</span>
          <h2 class="section-title">Tus puntos</h2>
          <div class="compact-stats">
            {dashboardStats.map((stat) => (
              <div class="compact-stat">
                <strong>{stat.value}</strong>
                <span>{stat.label}</span>
              </div>
            ))}
          </div>

          <div class="rules-box">
            {scoringRules.map((rule) => (
              <div class="rule-line">
                <strong>{rule.points}</strong>
                <span>{rule.title}</span>
              </div>
            ))}
          </div>
        </article>
      </div>
    </section>

    <section class="page-section simple-section">
      <div class="site-shell">
        <div class="table-row-head">
          <div>
            <span class="eyebrow">Ingresa pronósticos</span>
            <h2 class="section-title">Partidos abiertos</h2>
          </div>
          <span class="muted">Horario Chile · sede · transmisión</span>
        </div>

        <div class="simple-match-list">
          {matches.map((match) => (
            <article class="simple-match-card">
              <div class="simple-match-main">
                <div>
                  <div class="muted">{match.stage}</div>
                  <div class="simple-teams">
                    <span>{match.homeFlag} {match.home}</span>
                    <span class="muted">vs</span>
                    <span>{match.awayFlag} {match.away}</span>
                  </div>
                  <div class="muted">{match.kickoffChile} · {match.venue} · {match.city}</div>
                  <div class="muted">Transmite: {match.broadcasters.join(", ")}</div>
                </div>

                <div class="simple-score-entry">
                  <div class="input-like">{match.homePrediction}</div>
                  <div class="input-like">{match.awayPrediction}</div>
                  <button class="save-button">Guardar</button>
                </div>
              </div>

              <div class="simple-match-footer">
                <span class={`tag ${match.bonus ? "success" : ""}`}>{match.bonus ? "Bonus por favorito" : match.status}</span>
                <a class="accent" href={`/matches/${match.id}`}>Ver detalle</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
