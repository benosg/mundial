---
import { fetchFifaKnockoutMatchUpdates } from "../lib/fifa-results";
import { createServerClient } from "../lib/supabase";
import { shouldUseKnockoutAsDefaultView } from "../lib/knockout";

let target = "/groups";

try {
  const supabase = createServerClient(Astro.request, new Headers());
  const [groupMatchesResult, knockoutMatchesResult, fifaKnockoutUpdates] = await Promise.all([
    supabase.from("matches").select("home_result, away_result"),
    supabase.from("knockout_matches").select("id, phase, kickoff_at, home_result, away_result, penalties_winner"),
    fetchFifaKnockoutMatchUpdates().catch(() => []),
  ]);

  if (!groupMatchesResult.error && !knockoutMatchesResult.error) {
    const fifaUpdatesById = new Map(fifaKnockoutUpdates.map((match) => [match.id, match]));
    const knockoutMatches = (knockoutMatchesResult.data ?? []).map((match: any) => {
      const fifaMatch = fifaUpdatesById.get(match.id);

      return {
        ...match,
        home_result: match.home_result ?? fifaMatch?.home_result ?? null,
        away_result: match.away_result ?? fifaMatch?.away_result ?? null,
        penalties_winner: match.penalties_winner ?? fifaMatch?.penalties_winner ?? null,
      };
    });

    const useBracket = shouldUseKnockoutAsDefaultView(
      groupMatchesResult.data ?? [],
      knockoutMatches
    );

    if (useBracket) {
      target = "/bracket";
    }
  }
} catch {
  target = "/groups";
}

const redirectResponse = Astro.redirect(target);
void redirectResponse;
return redirectResponse;
---
