---
import Layout from "../layouts/Layout.astro";
import { groupedMatches } from "../data/site";

const allMatches: Record<string, typeof groupedMatches[0]['matches'][0]> = {};
groupedMatches.forEach((g) => {
  g.matches.forEach((m) => { allMatches[m.id] = m; });
});
const allMatchesJson = JSON.stringify(allMatches).replace(/</g, "\\u003c");
---

<Layout
  title="Compañeros"
  currentPath="/companions"
  description="Ve quiénes ya jugaron y revisa sus pronósticos del Mundial 2026."
>
  <main class="page-section">
    <div class="site-shell">
      <div class="table-row-head">
        <div>
          <span class="eyebrow">Compañeros</span>
          <h1 class="page-title">Ranking de Jugadores</h1>
        </div>
        <span class="muted" data-companions-count></span>
      </div>

      <p class="section-copy" data-companions-status>Cargando ranking...</p>

      <div class="ranking-table panel" data-companions-ranking>
        <table>
          <thead>
            <tr>
              <th scope="col">Pos</th>
              <th scope="col">Jugador</th>
              <th scope="col">Favorito</th>
              <th scope="col">Puntos</th>
              <th scope="col">Exactos (5)</th>
              <th scope="col">Ganador (3)</th>
              <th scope="col">Empate (3)</th>
              <th scope="col">Bonus Fav (+1)</th>
              <th scope="col">Completados</th>
              <th scope="col">Pronósticos</th>
            </tr>
          </thead>
          <tbody id="ranking-body"></tbody>
        </table>
      </div>

      <p class="muted small-note" style="margin-top:1rem" data-companions-note>Solo se muestran puntos de partidos con resultado real ingresado. Esta vista se actualiza cada 30 segundos.</p>

      <div class="inline-actions" style="margin-top:1.5rem">
        <a class="button-secondary" href="/">&#8592; Volver al inicio</a>
      </div>
    </div>
  </main>

  <!-- Player Detail Modal -->
  <div class="modal-overlay" data-player-modal style="display:none">
    <div class="modal-card modal-card-wide">
      <div class="player-dialog-head">
        <div>
          <span class="eyebrow">Pronósticos de</span>
          <h2 class="section-title" data-player-modal-name></h2>
          <span class="muted" data-player-modal-fav></span>
        </div>
        <button type="button" class="button-secondary dialog-close" data-player-modal-close>Cerrar</button>
      </div>

      <div class="player-predictions-grid" data-player-predictions-content>
        <p class="muted">Cargando pronósticos...</p>
      </div>
    </div>
  </div>

  <script id="all-matches-json" type="application/json" is:inline set:html={allMatchesJson}></script>

  <script is:inline>
    const allMatches = JSON.parse(document.getElementById("all-matches-json")?.textContent || "{}");

    function escapeHtml(value) {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#39;");
    }

    function safeNumber(value, fallback = 0) {
      return Number.isFinite(Number(value)) ? Number(value) : fallback;
    }

    function flagCodePoints(flag) {
      return Array.from(flag || "🏳️")
        .map((char) => char.codePointAt(0).toString(16))
        .join("-");
    }

    function resolveFlagValue(flag, teamOrLabel = "") {
      const team = String(teamOrLabel).replace(/^Favorito:\s*/, "").trim();
      if (team === "Inglaterra") return "\u{1F3F4}\u{E0067}\u{E0062}\u{E0065}\u{E006E}\u{E0067}\u{E007F}";
      if (team === "Escocia") return "\u{1F3F4}\u{E0067}\u{E0062}\u{E0073}\u{E0063}\u{E0074}\u{E007F}";
      return flag || "🏳️";
    }

    function flagImage(flag, sizeClass = "") {
      const classes = ["flag-icon", sizeClass].filter(Boolean).join(" ");
      return `<img class="${classes}" src="https://cdnjs.cloudflare.com/ajax/libs/twemoji/14.0.2/svg/${flagCodePoints(resolveFlagValue(flag))}.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" />`;
    }

    function flagWithLabel(flag, label, sizeClass = "") {
      return `<span class="flag-inline">${flagImage(resolveFlagValue(flag, label), sizeClass)}<span>${escapeHtml(label)}</span></span>`;
    }

    const rankingBody = document.getElementById("ranking-body");
    const companionsCount = document.querySelector("[data-companions-count]");
    const companionsStatus = document.querySelector("[data-companions-status]");
    const companionsNote = document.querySelector("[data-companions-note]");
    const playerModal = document.querySelector("[data-player-modal]");
    const playerModalName = document.querySelector("[data-player-modal-name]");
    const playerModalFav = document.querySelector("[data-player-modal-fav]");
    const playerModalClose = document.querySelector("[data-player-modal-close]");
    const playerPredictionsContent = document.querySelector("[data-player-predictions-content]");
    const AUTO_REFRESH_MS = 30000;

    let currentUserPromise = null;
    let currentPlayerModalId = null;
    let companionsRefreshInFlight = null;

    function hidePlayerModal() {
      if (playerModal) playerModal.style.display = "none";
      currentPlayerModalId = null;
    }

    if (playerModalClose) {
      playerModalClose.addEventListener("click", hidePlayerModal);
    }
    if (playerModal) {
      playerModal.addEventListener("click", (e) => {
        if (e.target === playerModal) hidePlayerModal();
      });
    }

    async function getCurrentUser() {
      if (currentUserPromise) return currentUserPromise;

      currentUserPromise = (async () => {
        try {
          const res = await fetch("/api/auth/session", { cache: "no-store" });
          const data = await res.json();
          if (data.ok && data.user) return data.user;
        } catch {}
        return null;
      })();

      return currentUserPromise;
    }

    async function refreshOfficialResults() {
      try {
        const res = await fetch("/api/results/refresh", { cache: "no-store" });
        const data = await res.json();

        if (!data.ok) {
          if (companionsNote) {
            companionsNote.textContent = "No se pudo consultar FIFA ahora. El ranking sigue mostrando los datos guardados más recientes.";
          }
          return;
        }

        if (companionsNote) {
          const throttleSeconds = Math.round((data.upstreamThrottleMs || 60000) / 1000);
          const refreshNote = data.source === "fifa"
            ? "Resultados oficiales revisados recién."
            : "Ranking actualizado con datos locales ya sincronizados.";
          companionsNote.textContent = `${refreshNote} FIFA se consulta como máximo cada ${throttleSeconds} segundos y esta vista se refresca cada 30 segundos.`;
        }
      } catch {
        if (companionsNote) {
          companionsNote.textContent = "Error de red al consultar FIFA. El ranking sigue mostrando los datos guardados más recientes.";
        }
      }
    }

    async function loadCompanions(options = {}) {
      if (companionsRefreshInFlight) {
        return companionsRefreshInFlight;
      }

      const { silent = false } = options;

      companionsRefreshInFlight = (async () => {
        if (!silent && companionsStatus) companionsStatus.textContent = "Actualizando ranking...";
        await refreshOfficialResults();

      const user = await getCurrentUser();
      let currentPlayerRecordId = null;

      if (user) {
        try {
          const bRes = await fetch(`/api/bootstrap?player_id=${encodeURIComponent(user.id)}`, { cache: "no-store" });
          const bData = await bRes.json();
          if (bData.ok && bData.player) {
            currentPlayerRecordId = bData.player.id;
          }
        } catch {}
      }

      try {
        const res = await fetch("/api/players", { cache: "no-store" });
        const data = await res.json();

        if (!data.ok) {
          console.error("[companions] API error:", data.error);
          if (companionsStatus) companionsStatus.textContent = "No se pudo cargar la lista.";
          return;
        }

        let allPlayers = [...(data.players || [])];

        if (currentPlayerRecordId && user) {
          const alreadyIncluded = allPlayers.some((p) => p.id === currentPlayerRecordId);
          if (!alreadyIncluded) {
            allPlayers.unshift({
              id: currentPlayerRecordId,
              name: user.name || "Sin nombre",
              favorite_team: null,
              favorite_flag: "🏳️",
              predictions_count: 0,
              joined: null,
              points_breakdown: {
                total_points: 0,
                exact_count: 0,
                winner_count: 0,
                draw_count: 0,
                favorite_bonus_count: 0,
                completed_count: 0,
              },
            });
          }
        }

        if (allPlayers.length === 0) {
          if (companionsStatus) companionsStatus.textContent = "Aún no hay jugadores registrados.";
          if (rankingBody) rankingBody.innerHTML = "";
          return;
        }

        if (companionsStatus) companionsStatus.textContent = `Ranking actualizado. Próxima revisión automática en ${AUTO_REFRESH_MS / 1000} segundos.`;
        if (companionsCount) companionsCount.textContent = `${allPlayers.length} jugador${allPlayers.length !== 1 ? "es" : ""}`;

        rankingBody.innerHTML = allPlayers
          .map((p, index) => {
            const pb = p.points_breakdown || { total_points: 0, exact_count: 0, winner_count: 0, draw_count: 0, favorite_bonus_count: 0, completed_count: 0 };
            const isCurrentUser = currentPlayerRecordId && p.id === currentPlayerRecordId;
            const rankingPosition = safeNumber(p.ranking_position, index + 1);
            const tieCount = safeNumber(p.ranking_tie_count, 1);
            const hasPrizeTie = rankingPosition <= 3 && tieCount > 1;
            const tieBadge = hasPrizeTie ? '<span class="ranking-tie-badge">Empate · premio compartido</span>' : '';
            const safeName = escapeHtml(p.name || 'Sin nombre');
            const safePlayerId = escapeHtml(p.id || '');
            return `
            <tr class="companion-row" data-player-id="${safePlayerId}" tabindex="0" role="button" aria-label="Ver pronósticos de ${safeName}">
              <td class="rank">${rankingPosition}</td>
              <td class="ranking-name-cell">
                <div class="ranking-name">${safeName} ${isCurrentUser ? '<span class="tag-you">Tú</span>' : ''}</div>
                ${tieBadge}
              </td>
              <td>${p.favorite_team ? flagWithLabel(p.favorite_flag || '🏳️', p.favorite_team) : '<span class="muted">Sin favorito</span>'}</td>
              <td class="points-cell"><strong class="points-total">${safeNumber(pb.total_points)}</strong></td>
              <td class="points-cell">${safeNumber(pb.exact_count)}</td>
              <td class="points-cell">${safeNumber(pb.winner_count)}</td>
              <td class="points-cell">${safeNumber(pb.draw_count)}</td>
              <td class="points-cell">${safeNumber(pb.favorite_bonus_count)}</td>
              <td class="points-cell">${safeNumber(pb.completed_count)}</td>
              <td class="points-cell muted">${safeNumber(p.predictions_count)}</td>
            </tr>`;
          })
          .join("");

        rankingBody.querySelectorAll(".companion-row").forEach((row) => {
          const handler = () => openPlayerDetail(row.dataset.playerId);
          row.addEventListener("click", handler);
          row.addEventListener("keydown", (e) => {
            if (e.key === "Enter" || e.key === " ") {
              e.preventDefault();
              handler();
            }
          });
        });

        if (currentPlayerModalId) {
          await openPlayerDetail(currentPlayerModalId, { silent: true });
        }
      } catch (err) {
        console.error("[companions] Failed to load:", err);
        if (companionsStatus) companionsStatus.textContent = "Error de red al cargar compañeros.";
      } finally {
        companionsRefreshInFlight = null;
      }
      })();

      return companionsRefreshInFlight;
    }

    async function openPlayerDetail(playerId, options = {}) {
      if (!playerModal || !playerModalName || !playerPredictionsContent) return;

      const { silent = false } = options;
      currentPlayerModalId = playerId;

      playerModal.style.display = "";
      if (!silent) {
        playerModalName.textContent = "Cargando...";
        if (playerModalFav) playerModalFav.textContent = "";
        playerPredictionsContent.innerHTML = '<p class="muted">Cargando pronósticos...</p>';
      }

      try {
        const res = await fetch(`/api/players?id=${encodeURIComponent(playerId)}`, { cache: "no-store" });
        const data = await res.json();

        if (!data.ok) {
          playerPredictionsContent.innerHTML = '<p class="muted">No se pudo cargar la información.</p>';
          return;
        }

        playerModalName.textContent = data.player.name;
        if (playerModalFav) {
          playerModalFav.innerHTML = data.player.favorite_team
            ? flagWithLabel(data.player.favorite_flag || '🏳️', `Favorito: ${data.player.favorite_team}`)
            : "Sin equipo favorito";
        }

        const hasGroupPredictions = Array.isArray(data.predictions) && data.predictions.length > 0;
        const hasBracketPredictions = Array.isArray(data.bracketPredictions) && data.bracketPredictions.length > 0;

        if (!hasGroupPredictions && !hasBracketPredictions) {
          playerPredictionsContent.innerHTML = '<p class="muted">Este jugador aún no ha cargado pronósticos.</p>';
          return;
        }

        let html = "";

        const renderedGroups = playerPredictionsContent.querySelectorAll("details[data-group], details[data-phase]");
        const hasPreviousGroupState = renderedGroups.length > 0;
        const openGroups = new Set(
          Array.from(playerPredictionsContent.querySelectorAll("details[open]"))
            .map((detail) => detail.getAttribute("data-group") || detail.getAttribute("data-phase"))
            .filter(Boolean)
        );

        if (hasGroupPredictions) {
          const grouped = {};
          data.predictions.forEach((pred) => {
            const group = pred.match_id.charAt(0);
            if (!grouped[group]) grouped[group] = [];
            grouped[group].push(pred);
          });

          const sortedGroups = Object.keys(grouped).sort();

          sortedGroups.forEach((group, i) => {
            const preds = grouped[group];
            const shouldOpen = hasPreviousGroupState ? openGroups.has(group) : i < 2;
            const openAttr = shouldOpen ? ' open' : '';
            html += `<details class="group-collapsible player-group-card" data-group="${group}"${openAttr}>
              <summary class="group-head"><span>Grupo ${group}</span></summary>
              <div class="readonly-list">`;

            preds.forEach((pred) => {
              const match = allMatches[pred.match_id];
              if (!match) return;
              const predPoints = safeNumber(pred.points);
              const homeScore = safeNumber(pred.home_score);
              const awayScore = safeNumber(pred.away_score);
              const pointsInfo = predPoints > 0
                ? `<span class="tag ${pred.type === 'exact' ? 'success' : ''}" style="font-size:0.75rem; margin-left:0.5rem;">+${predPoints} ${pred.favoriteBonus ? '★' : ''}</span>`
                : pred.type === "pending"
                ? '<span class="muted" style="font-size:0.75rem; margin-left:0.5rem;">Pendiente</span>'
                : '<span class="muted" style="font-size:0.75rem; margin-left:0.5rem;">0 pts</span>';

              html += `
                <div class="readonly-row">
                  <div class="fixture-cell" style="min-width:auto">
                    <span>${flagWithLabel(match.homeFlag, match.home)}</span>
                    <span class="muted">vs</span>
                    <span>${flagWithLabel(match.awayFlag, match.away)}</span>
                  </div>
                  <div class="readonly-score">
                    <span class="readonly-pill">${homeScore}</span>
                    <span class="muted">-</span>
                    <span class="readonly-pill">${awayScore}</span>
                    ${pointsInfo}
                  </div>
                </div>`;
            });

            html += `</div></details>`;
          });
        }

        if (hasBracketPredictions) {
          const phaseOrder = ["16avos", "8vos", "4tos", "semis", "3er/4to lugar", "final"];
          const groupedBracket = {};
          data.bracketPredictions.forEach((pred) => {
            const phase = pred.phase || "Otras";
            if (!groupedBracket[phase]) groupedBracket[phase] = [];
            groupedBracket[phase].push(pred);
          });

          phaseOrder.filter((phase) => groupedBracket[phase]).forEach((phase, i) => {
            const preds = groupedBracket[phase];
            const shouldOpen = hasPreviousGroupState ? openGroups.has(phase) : !hasGroupPredictions && i < 2;
            html += `<details class="group-collapsible player-group-card" data-phase="${phase}"${shouldOpen ? " open" : ""}>
              <summary class="group-head"><span>${phase}</span></summary>
              <div class="readonly-list">`;

            preds.forEach((pred) => {
              const predPoints = safeNumber(pred.points);
              const homeScore = safeNumber(pred.home_score);
              const awayScore = safeNumber(pred.away_score);
              const pointsInfo = predPoints > 0
                ? `<span class="tag ${pred.type === 'exact' ? 'success' : ''}" style="font-size:0.75rem; margin-left:0.5rem;">+${predPoints}</span>`
                : pred.type === "pending"
                ? '<span class="muted" style="font-size:0.75rem; margin-left:0.5rem;">Pendiente</span>'
                : '<span class="muted" style="font-size:0.75rem; margin-left:0.5rem;">0 pts</span>';
              const pensInfo = pred.home_score === pred.away_score && pred.penalties_winner
                ? `<div class="muted small-note">Penales: ${escapeHtml(pred.penalties_winner === 'home' ? pred.home : pred.away)}</div>`
                : "";

              html += `
                <div class="readonly-row readonly-row--stacked">
                  <div class="fixture-cell" style="min-width:auto">
                    <strong>${escapeHtml(pred.label)}</strong>
                    <span>${escapeHtml(pred.home)}</span>
                    <span class="muted">vs</span>
                    <span>${escapeHtml(pred.away)}</span>
                  </div>
                  <div class="readonly-score">
                    <span class="readonly-pill">${homeScore}</span>
                    <span class="muted">-</span>
                    <span class="readonly-pill">${awayScore}</span>
                    ${pointsInfo}
                  </div>
                  ${pensInfo}
                </div>`;
            });

            html += `</div></details>`;
          });
        }

        playerPredictionsContent.innerHTML = html;
      } catch {
        playerPredictionsContent.innerHTML = '<p class="muted">Error de red al cargar.</p>';
      }
    }

    loadCompanions();
    setInterval(() => {
      void loadCompanions({ silent: true });
    }, AUTO_REFRESH_MS);
  </script>

  <style is:global>
    .ranking-table {
      overflow-x: auto;
    }

    .ranking-table table {
      width: 100%;
      font-size: 0.92rem;
    }

    .ranking-table th,
    .ranking-table td {
      padding: 0.85rem 0.75rem;
      vertical-align: middle;
    }

    .ranking-table th {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--muted);
    }

    .ranking-name-cell {
      min-width: 180px;
    }

    .ranking-tie-badge {
      display: inline-flex;
      width: fit-content;
      margin-top: 0.25rem;
      border: 1px solid rgba(245, 158, 11, 0.28);
      border-radius: 999px;
      padding: 0.12rem 0.45rem;
      background: rgba(245, 158, 11, 0.12);
      color: #92400e;
      font-size: 0.72rem;
      font-weight: 700;
    }

    .points-cell {
      text-align: center;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
    }

    .points-total {
      font-size: 1.1rem;
      color: var(--accent);
    }

    .companion-row {
      cursor: pointer;
      transition: background 0.15s ease;
    }

    .companion-row:hover {
      background: rgba(15, 118, 110, 0.04);
    }

    .companion-row:focus-visible {
      outline: 3px solid var(--focus);
      outline-offset: -3px;
    }

    @media (max-width: 960px) {
      .ranking-table th:nth-child(5),
      .ranking-table th:nth-child(6),
      .ranking-table th:nth-child(7),
      .ranking-table th:nth-child(8),
      .ranking-table td:nth-child(5),
      .ranking-table td:nth-child(6),
      .ranking-table td:nth-child(7),
      .ranking-table td:nth-child(8) {
        display: none;
      }
    }

    @media (max-width: 640px) {
      .ranking-table th:nth-child(3),
      .ranking-table td:nth-child(3) {
        display: none;
      }

      .ranking-table th,
      .ranking-table td {
        padding: 0.6rem 0.4rem;
        font-size: 0.82rem;
      }

      .ranking-name-cell {
        min-width: auto;
      }
    }
  </style>
</Layout>
