---
import Layout from "../../layouts/Layout.astro";
import { matches } from "../../data/site";
---

<Layout title="Partidos" currentPath="/matches" description="Fixture demo del Mundial 2026 con horarios en Chile, sede y transmisión local.">
  <main class="page-section">
    <div class="site-shell">
      <span class="eyebrow">Fixture Mundial 2026</span>
      <h1 class="page-title">Todos los partidos listos para pronosticar.</h1>
      <p class="section-copy">Cada tarjeta muestra horario chileno, estadio, ciudad y señales donde se vería en Chile.</p>

      <section class="cards-grid spaced">
        {matches.map((match) => (
          <article class="match-card">
            <div class="match-top">
              <span class="tag">{match.stage}</span>
              <span class="tag warning">{match.status}</span>
            </div>
            <p class="versus">{match.home} vs {match.away}</p>
            <p class="muted">{match.kickoffChile}</p>
            <p class="muted">{match.venue} · {match.city}</p>
            <div class="chip-row spaced">
              {match.broadcasters.map((item) => <span class="tag">{item}</span>)}
            </div>
            <div class="match-bottom spaced">
              <span class={`tag ${match.bonus ? "success" : ""}`}>{match.bonus ? "Tu favorito juega" : "Partido estándar"}</span>
              <a class="accent" href={`/matches/${match.id}`}>Abrir detalle →</a>
            </div>
          </article>
        ))}
      </section>
    </div>
  </main>
</Layout>
