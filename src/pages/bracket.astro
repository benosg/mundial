---
import Layout from "../layouts/Layout.astro";
import { knockoutFixturesByPhase, knockoutPhaseOrder } from "../data/knockout";

const bracketColumns = {
  left: [
    { phase: "16avos", label: "16avos 1-8", matchIds: ["73", "74", "75", "76", "77", "78", "79", "80"] },
    { phase: "8vos", label: "8vos 1-4", matchIds: ["89", "90", "91", "92"] },
    { phase: "4tos", label: "4tos 1-2", matchIds: ["97", "98"] },
    { phase: "semis", label: "Semi 1", matchIds: ["101"] },
  ],
  center: [
    { phase: "final", label: "Final", matchIds: ["104"] },
    { phase: "3er/4to lugar", label: "3er y 4to lugar", matchIds: ["103"] },
  ],
  right: [
    { phase: "semis", label: "Semi 2", matchIds: ["102"] },
    { phase: "4tos", label: "4tos 3-4", matchIds: ["99", "100"] },
    { phase: "8vos", label: "8vos 5-8", matchIds: ["93", "94", "95", "96"] },
    { phase: "16avos", label: "16avos 9-16", matchIds: ["81", "82", "83", "84", "85", "86", "87", "88"] },
  ],
} as const;
const phasesJson = JSON.stringify(knockoutFixturesByPhase).replace(/</g, "\\u003c");
---

<Layout
  title="Llaves"
  currentPath="/bracket"
  description="Pronósticos del cuadro eliminatorio del Mundial 2026 con guardado único, bloqueo por ronda y definición por penales cuando corresponde."
>
  <div class="simple-main bracket-page">
    <section class="simple-top" aria-labelledby="bracket-title">
      <div class="site-shell simple-stack">
        <div class="hero-copy-block bracket-hero-copy">
          <span class="eyebrow">Cuadro eliminatorio</span>
          <h1 class="simple-title" id="bracket-title">Pronóstico de llaves</h1>
          <p class="section-copy section-copy-tight">Arma tu cuadro completo en un formato horizontal clásico. La llave agrupa y guarda automáticamente tus pronósticos por ronda, con bloqueo por horario y definición por penales cuando hay empate.</p>
        </div>

        <div class="hero-badges bracket-hero-badges" aria-label="Aspectos clave de la llave">
          <span class="hero-badge">Desliza por fases</span>
          <span class="hero-badge">Guardado único por ronda</span>
          <span class="hero-badge">Penales obligatorios en empates</span>
        </div>

        <div class="summary-grid">
          <article class="summary-box highlight">
            <div class="muted">Jugador</div>
            <strong data-player-name-display>Inicia sesión para jugar</strong>
            <span data-player-fav-display class="muted">Completa la llave y define penales en los empates</span>
          </article>
          <article class="summary-box">
            <div class="muted">Fases</div>
            <strong>{knockoutPhaseOrder.length}</strong>
          </article>
          <article class="summary-box">
            <div class="muted">Partidos</div>
            <strong>32</strong>
          </article>
          <article class="summary-box">
            <div class="muted">Modo</div>
            <strong>Cuadro separado</strong>
          </article>
        </div>
      </div>
    </section>

    <section class="page-section simple-section" data-auth-gate style="display:none">
      <div class="site-shell">
        <article class="panel auth-gate-panel">
          <div class="auth-gate-inner">
            <span class="eyebrow">Acceso requerido</span>
            <h2 class="section-title">Inicia sesión para guardar tu llave</h2>
            <p class="muted" style="margin-bottom:1.2rem">Necesitás una cuenta de Google para persistir tu llave completa.</p>
            <a class="button" href="/api/auth/signin">Iniciar sesión con Google</a>
          </div>
        </article>
      </div>
    </section>

    <section class="page-section simple-section workspace-section" data-workspace-section style="display:none">
      <div class="site-shell bracket-layout">
        <article class="panel bracket-board-panel">
          <div class="bracket-board-header">
            <div>
              <span class="eyebrow">Llave completa</span>
              <h2 class="section-title section-title-compact">Vista clásica de llaves</h2>
              <p class="muted bracket-board-copy">Los cruces avanzan desde ambos lados hacia el centro. Cada fase se habilita cuando finaliza la anterior.</p>
            </div>

            <div class="bracket-phase-nav" aria-label="Ir a una fase del cuadro">
              {knockoutFixturesByPhase.map((phase) => (
                <button class="button-secondary bracket-phase-nav-button" type="button" data-bracket-jump={phase.phase}>{phase.label}</button>
              ))}
            </div>

            <div class="bracket-save-row" aria-label="Guardar pronósticos de la llave">
              <button class="button button-compact bracket-save-button" type="button" data-phase-save="all">Guardar llave</button>
            </div>
            <p class="save-status" data-bracket-save-status role="status"></p>
          </div>

          <div class="bracket-scroll-shell" data-bracket-scroll-shell tabindex="0">
            <div class="bracket-board" data-bracket-board>
              <div class="bracket-wing bracket-wing--left" aria-label="Lado izquierdo de la llave">
                {bracketColumns.left.map((column, index) => (
                  <section class="bracket-phase-panel bracket-phase-panel--split" data-phase-panel={column.phase} data-bracket-side="left" data-bracket-depth={index} id={`bracket-column-left-${column.phase.replaceAll("/", "-").replaceAll(" ", "-")}-${index}`}>
                    <div class="bracket-phase-head">
                      <div>
                        <span class="eyebrow">Fase eliminatoria</span>
                        <h2 class="entry-title">{column.label}</h2>
                      </div>
                    </div>

                    <div class="bracket-match-list" data-phase-matches={column.phase} data-match-ids={column.matchIds.join(",")} data-bracket-side="left" data-bracket-depth={index}></div>
                  </section>
                ))}
              </div>

              <div class="bracket-center" aria-label="Finales de la llave">
                {bracketColumns.center.map((column, index) => (
                  <section class="bracket-phase-panel bracket-phase-panel--center" data-phase-panel={column.phase} data-bracket-side="center" data-center-index={index} id={`bracket-column-center-${index}`}>
                    <div class="bracket-phase-head">
                      <div>
                        <span class="eyebrow">Centro</span>
                        <h2 class="entry-title">{column.label}</h2>
                      </div>
                    </div>

                    <div class="bracket-match-list" data-phase-matches={column.phase} data-match-ids={column.matchIds.join(",")} data-bracket-side="center" data-center-index={index}></div>
                  </section>
                ))}
              </div>

              <div class="bracket-wing bracket-wing--right" aria-label="Lado derecho de la llave">
                {bracketColumns.right.map((column, index) => (
                  <section class="bracket-phase-panel bracket-phase-panel--split" data-phase-panel={column.phase} data-bracket-side="right" data-bracket-depth={index} id={`bracket-column-right-${column.phase.replaceAll("/", "-").replaceAll(" ", "-")}-${index}`}>
                    <div class="bracket-phase-head">
                      <div>
                        <span class="eyebrow">Fase eliminatoria</span>
                        <h2 class="entry-title">{column.label}</h2>
                      </div>
                    </div>

                    <div class="bracket-match-list" data-phase-matches={column.phase} data-match-ids={column.matchIds.join(",")} data-bracket-side="right" data-bracket-depth={index}></div>
                  </section>
                ))}
              </div>
            </div>
          </div>
        </article>

        <div class="workspace-column workspace-sidebar-stack bracket-sidebar-stack">
          <article class="panel compact-panel workspace-rules">
            <span class="eyebrow">Reglas del cuadro</span>
            <h2 class="section-title section-title-compact">Cómo puntúa la llave</h2>

            <div class="rules-highlight">
              <ul>
                <li><strong>5 puntos</strong> por acertar marcador exacto.</li>
                <li><strong>3 puntos</strong> por acertar el ganador del cruce.</li>
                <li><strong>0 puntos</strong> si el ganador no coincide.</li>
                <li>Si pronosticas <strong>empate</strong>, debes elegir ganador por <strong>penales</strong>.</li>
                <li>En empates reales, el exacto exige <strong>marcador exacto + penales correctos</strong>.</li>
              </ul>
            </div>

            <p class="fair-note">Cada fase abre cuando termina la anterior y se bloquea 10 minutos antes del primer partido de esa fase. El botón Guardar llave agrupa automáticamente tus pronósticos por ronda. Los puntos de la llave se suman al ranking general.</p>

            <div class="inline-actions">
              <a class="button-secondary" href="/groups">Ver fase de grupos</a>
              <a class="button-secondary" href="/companions">Ver ranking</a>
            </div>
          </article>
        </div>
      </div>
    </section>
  </div>

  <script id="knockout-phases-json" type="application/json" is:inline set:html={phasesJson}></script>

  <script is:inline>
    const phasesData = JSON.parse(document.getElementById("knockout-phases-json")?.textContent || "[]");
    const STORAGE_KEY = "mundial-2026-player-id";
    const authGate = document.querySelector("[data-auth-gate]");
    const workspaceSection = document.querySelector("[data-workspace-section]");
    const playerNameDisplay = document.querySelector("[data-player-name-display]");
    const playerFavDisplay = document.querySelector("[data-player-fav-display]");
    const bracketSaveStatus = document.querySelector("[data-bracket-save-status]");
    let currentPlayerKey = null;
    let currentServerPlayer = null;
    let matchesById = new Map();
    let predictionsById = new Map();
    let refreshEveryMs = 60000;
    let bracketRefreshTimer = null;
    let bracketLoadInFlight = null;

    function getPlayerId() {
      let id = localStorage.getItem(STORAGE_KEY);
      if (!id) {
        id = crypto.randomUUID();
        localStorage.setItem(STORAGE_KEY, id);
      }
      return id;
    }

    function escapeHtml(value) {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#39;");
    }

    function flagCodePoints(flag) {
      return Array.from(flag || "🏳️")
        .map((char) => char.codePointAt(0)?.toString(16))
        .filter(Boolean)
        .join("-");
    }

    function resolveFlagValue(flag, teamOrLabel = "") {
      const team = String(teamOrLabel).replace(/^Favorito:\s*/, "").trim();
      if (team === "Inglaterra") return "\u{1F3F4}\u{E0067}\u{E0062}\u{E0065}\u{E006E}\u{E0067}\u{E007F}";
      if (team === "Escocia") return "\u{1F3F4}\u{E0067}\u{E0062}\u{E0073}\u{E0063}\u{E0074}\u{E007F}";
      return flag || "🏳️";
    }

    function flagImage(flag, teamOrLabel = "") {
      const resolvedFlag = resolveFlagValue(flag, teamOrLabel);
      if (!resolvedFlag || resolvedFlag === "🏳️") return "";

      return `<img class="flag-icon bracket-team-flag" src="https://cdnjs.cloudflare.com/ajax/libs/twemoji/14.0.2/svg/${flagCodePoints(resolvedFlag)}.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" />`;
    }

    function formatChileDate(iso) {
      return new Intl.DateTimeFormat("es-CL", {
        timeZone: "Etc/GMT+4",
        day: "2-digit",
        month: "short",
        hour: "2-digit",
        minute: "2-digit",
        hour12: false,
      }).format(new Date(iso)).replace(",", " ·");
    }

    function hasIntegerScore(value) {
      return Number.isInteger(value);
    }

    function parseScoreValue(value) {
      if (hasIntegerScore(value)) return value;
      if (typeof value !== "string" || value.trim() === "") return null;

      const parsed = Number.parseInt(value, 10);
      return Number.isInteger(parsed) ? parsed : null;
    }

    function getWinnerSide(homeScore, awayScore, penaltiesWinner = null) {
      if (homeScore > awayScore) return "home";
      if (awayScore > homeScore) return "away";
      return penaltiesWinner === "home" || penaltiesWinner === "away" ? penaltiesWinner : null;
    }

    function phaseClassName(phase) {
      return phase
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replaceAll("/", "-")
        .replaceAll(" ", "-")
        .toLowerCase();
    }

    function normalizeReferenceLabel(value) {
      return String(value || "")
        .trim()
        .toUpperCase()
        .replace(/\s+/g, "");
    }

    function shouldHideResolvedReferenceSlot(slot, team) {
      const normalizedSlot = normalizeReferenceLabel(slot);
      const normalizedTeam = normalizeReferenceLabel(team);

      return /^(W|RU)\d+$/.test(normalizedSlot) && normalizedTeam !== "" && normalizedTeam !== normalizedSlot;
    }

    function parseReferenceSlot(slot) {
      const match = normalizeReferenceLabel(slot).match(/^(W|RU)(\d+)$/);
      if (!match) return null;

      return {
        type: match[1] === "W" ? "winner" : "runner-up",
        matchId: match[2],
      };
    }

    function getPredictionOutcome(prediction) {
      const homeScore = parseScoreValue(prediction?.home_score);
      const awayScore = parseScoreValue(prediction?.away_score);
      if (!prediction || homeScore === null || awayScore === null) {
        return null;
      }

      if (homeScore === awayScore
        && prediction.penalties_winner !== "home"
        && prediction.penalties_winner !== "away") {
        return null;
      }

      const winnerSide = getWinnerSide(homeScore, awayScore, prediction.penalties_winner);
      return winnerSide ? { winnerSide } : null;
    }

    function getOfficialMatchOutcome(match) {
      if (!match || !hasIntegerScore(match.home_result) || !hasIntegerScore(match.away_result)) {
        return null;
      }

      if (match.home_result === match.away_result
        && match.penalties_winner !== "home"
        && match.penalties_winner !== "away") {
        return null;
      }

      const winnerSide = getWinnerSide(match.home_result, match.away_result, match.penalties_winner);
      return winnerSide ? { winnerSide } : null;
    }

    function resolveReferenceTeam(slot, displayMatchesById, activePredictionsById) {
      const reference = parseReferenceSlot(slot);
      if (!reference) return null;

      const sourceDisplayMatch = displayMatchesById.get(reference.matchId);
      const sourceBaseMatch = matchesById.get(reference.matchId);
      if (!sourceDisplayMatch || !sourceBaseMatch) return null;

      const officialOutcome = getOfficialMatchOutcome(sourceBaseMatch);
      const predictedOutcome = getPredictionOutcome(activePredictionsById.get(reference.matchId));
      const resolvedOutcome = officialOutcome || predictedOutcome;
      if (!resolvedOutcome) return null;

      const resolvedSide = reference.type === "winner"
        ? resolvedOutcome.winnerSide
        : resolvedOutcome.winnerSide === "home"
          ? "away"
          : "home";
      const team = sourceDisplayMatch[`${resolvedSide}_team`];
      const sourceSlot = sourceDisplayMatch[`${resolvedSide}_slot`];
      if (!team || team === sourceSlot) return null;

      return {
        team,
        flag: sourceDisplayMatch[`${resolvedSide}_flag`],
        provisional: !officialOutcome,
      };
    }

    function buildDisplayMatches(draftPredictions = null) {
      const activePredictionsById = new Map(predictionsById);
      if (draftPredictions) {
        draftPredictions.forEach((prediction, matchId) => {
          activePredictionsById.set(matchId, prediction);
        });
      }

      const displayMatchesById = new Map();

      phasesData.forEach((phaseBlock) => {
        phaseBlock.matches.forEach((fixture) => {
          const baseMatch = matchesById.get(fixture.id);
          if (!baseMatch) return;

          const homeReferenceTeam = baseMatch.home_team === baseMatch.home_slot
            ? resolveReferenceTeam(baseMatch.home_slot, displayMatchesById, activePredictionsById)
            : null;
          const awayReferenceTeam = baseMatch.away_team === baseMatch.away_slot
            ? resolveReferenceTeam(baseMatch.away_slot, displayMatchesById, activePredictionsById)
            : null;

          displayMatchesById.set(fixture.id, {
            ...baseMatch,
            home_team: homeReferenceTeam?.team || baseMatch.home_team,
            away_team: awayReferenceTeam?.team || baseMatch.away_team,
            home_flag: homeReferenceTeam?.flag || baseMatch.home_flag,
            away_flag: awayReferenceTeam?.flag || baseMatch.away_flag,
            home_display_provisional: Boolean(baseMatch.home_provisional || homeReferenceTeam?.provisional),
            away_display_provisional: Boolean(baseMatch.away_provisional || awayReferenceTeam?.provisional),
          });
        });
      });

      return displayMatchesById;
    }

    function getBracketSlot(index, total, side, centerIndex) {
      if (side === "center") {
        return { start: centerIndex === "1" ? 10 : 7, span: 3 };
      }

      const span = Math.max(2, 16 / total);
      return { start: Math.round(index * span) + 1, span };
    }

    function setBracketStatus(message, state = "") {
      if (!bracketSaveStatus) return;
      bracketSaveStatus.textContent = message;
      bracketSaveStatus.dataset.state = state;
    }

    function captureDraftPredictions() {
      const draft = new Map();

      document.querySelectorAll("[data-match-score]").forEach((input) => {
        const matchId = input.dataset.matchScore;
        const side = input.dataset.side;
        if (!matchId || !side) return;
        const current = draft.get(matchId) || { home_score: "", away_score: "", penalties_winner: null };
        current[`${side}_score`] = input.value;
        draft.set(matchId, current);
      });

      draft.forEach((value, matchId) => {
        const checked = document.querySelector(`input[name="pens-${matchId}"]:checked`);
        value.penalties_winner = checked?.value || null;
      });

      return draft;
    }

    function restoreDraftPredictions(draft) {
      draft.forEach((prediction, matchId) => {
        const match = matchesById.get(matchId);
        if (!isMatchEditable(match)) return;

        const homeInput = document.querySelector(`[data-match-score="${matchId}"][data-side="home"]`);
        const awayInput = document.querySelector(`[data-match-score="${matchId}"][data-side="away"]`);
        if (homeInput) homeInput.value = prediction.home_score;
        if (awayInput) awayInput.value = prediction.away_score;

        document.querySelectorAll(`input[name="pens-${matchId}"]`).forEach((input) => {
          input.checked = input.value === prediction.penalties_winner;
        });

        updatePenaltiesVisibility(matchId);
      });
    }

    function scheduleBracketRefresh() {
      if (bracketRefreshTimer) {
        window.clearInterval(bracketRefreshTimer);
      }

      bracketRefreshTimer = window.setInterval(async () => {
        if (document.visibilityState !== "visible") return;
        if (document.querySelector('[data-phase-save][data-saving="true"]')) return;

        try {
          await loadBracket({ preserveDraft: true, silentErrors: true });
        } catch {}
      }, refreshEveryMs);
    }

    function isMatchDefined(match) {
      return !!match
        && match.home_team !== match.home_slot
        && match.away_team !== match.away_slot
        && !match.home_provisional
        && !match.away_provisional;
    }

    function isMatchEditable(match) {
      if (!isMatchDefined(match)) return false;

      const kickoffTime = Date.parse(match.kickoff_at);
      return !Number.isNaN(kickoffTime) && Date.now() < kickoffTime - 10 * 60 * 1000;
    }

    function renderMatch(match, prediction, editable, phase, slot) {
      const homeValue = Number.isInteger(prediction?.home_score) ? prediction.home_score : "";
      const awayValue = Number.isInteger(prediction?.away_score) ? prediction.away_score : "";
      const needsPens = prediction && prediction.home_score === prediction.away_score;
      const showPens = needsPens || (match.home_result !== null && match.home_result === match.away_result);
      const classes = [
        "bracket-match-card",
        `bracket-match-card--${phaseClassName(phase)}`,
      ].filter(Boolean).join(" ");
      const actualResult = match.home_result !== null && match.away_result !== null
        ? `<div class="bracket-result-note muted small-note">Real: ${match.home_result}-${match.away_result}${match.home_result === match.away_result && match.penalties_winner ? ` · penales ${match.penalties_winner === 'home' ? escapeHtml(match.home_team) : escapeHtml(match.away_team)}` : ""}</div>`
        : "";
      const broadcasters = Array.isArray(match.broadcasters) && match.broadcasters.length > 0
        ? `<div class="bracket-broadcasters muted small-note">${escapeHtml(match.broadcasters.join(" · "))}</div>`
        : "";
      const homeBadge = match.home_display_provisional ? '<span class="bracket-team-badge">Provisorio</span>' : "";
      const awayBadge = match.away_display_provisional ? '<span class="bracket-team-badge">Provisorio</span>' : "";
      const homeSlotLabel = shouldHideResolvedReferenceSlot(match.home_slot, match.home_team)
        ? ""
        : `<span class="bracket-slot">${escapeHtml(match.home_slot)}</span>`;
      const awaySlotLabel = shouldHideResolvedReferenceSlot(match.away_slot, match.away_team)
        ? ""
        : `<span class="bracket-slot">${escapeHtml(match.away_slot)}</span>`;

      return `
        <div class="bracket-match-slot" style="--slot-start:${slot.start}; --slot-span:${slot.span}">
        <article class="${classes}" data-match-card="${match.id}">
          <div class="bracket-match-top">
            <div class="muted small-note bracket-match-meta">${formatChileDate(match.kickoff_at)} · ${escapeHtml(match.city)}</div>
          </div>

          <div class="bracket-match-subhead muted small-note">${escapeHtml(match.venue)}, ${escapeHtml(match.city)}</div>
          ${broadcasters}

          <div class="bracket-teams-grid">
            <div class="bracket-team-row">
              <div class="bracket-team-copy">
                ${homeSlotLabel}
                <strong class="bracket-team-name">${flagImage(match.home_flag, match.home_team)}<span>${escapeHtml(match.home_team)}</span>${homeBadge}</strong>
              </div>
              <div class="bracket-score-inputs">
                <input type="number" min="0" max="20" inputmode="numeric" data-match-score="${match.id}" data-side="home" value="${homeValue}" ${editable ? "" : "disabled"} />
              </div>
            </div>
            <div class="bracket-team-row">
              <div class="bracket-team-copy">
                ${awaySlotLabel}
                <strong class="bracket-team-name">${flagImage(match.away_flag, match.away_team)}<span>${escapeHtml(match.away_team)}</span>${awayBadge}</strong>
              </div>
              <div class="bracket-score-inputs">
                <input type="number" min="0" max="20" inputmode="numeric" data-match-score="${match.id}" data-side="away" value="${awayValue}" ${editable ? "" : "disabled"} />
              </div>
            </div>
          </div>
          <div class="bracket-penalties" data-match-penalties="${match.id}" style="display:${showPens ? "grid" : "none"}">
            <span class="muted">Penales si termina empate:</span>
            <label><input type="radio" name="pens-${match.id}" value="home" ${prediction?.penalties_winner === "home" ? "checked" : ""} ${editable ? "" : "disabled"} /> ${escapeHtml(match.home_team)}</label>
            <label><input type="radio" name="pens-${match.id}" value="away" ${prediction?.penalties_winner === "away" ? "checked" : ""} ${editable ? "" : "disabled"} /> ${escapeHtml(match.away_team)}</label>
          </div>

          ${actualResult}
        </article>
        </div>`;
    }

    function updatePenaltiesVisibility(matchId) {
      const homeInput = document.querySelector(`[data-match-score="${matchId}"][data-side="home"]`);
      const awayInput = document.querySelector(`[data-match-score="${matchId}"][data-side="away"]`);
      const penalties = document.querySelector(`[data-match-penalties="${matchId}"]`);
      if (!homeInput || !awayInput || !penalties) return;
      const show = homeInput.value !== "" && awayInput.value !== "" && homeInput.value === awayInput.value;
      penalties.style.display = show ? "grid" : "none";
      if (!show) {
        penalties.querySelectorAll('input[type="radio"]').forEach((input) => { input.checked = false; });
      }
    }

    function hasEditablePhase() {
      return phasesData.some((phaseBlock) => phaseBlock.matches.some((fixture) => isMatchEditable(matchesById.get(fixture.id))));
    }

    function rerenderFromDraft(focusSelector = "") {
      const draftPredictions = captureDraftPredictions();
      render(draftPredictions);
      restoreDraftPredictions(draftPredictions);
      if (focusSelector) {
        document.querySelector(focusSelector)?.focus();
      }
    }

    function render(draftPredictions = null) {
      const displayMatchesById = buildDisplayMatches(draftPredictions);

      phasesData.forEach((phaseBlock) => {
        const phase = phaseBlock.phase;
        document.querySelectorAll(`[data-phase-matches="${phase}"]`).forEach((container) => {
          const matchIds = (container.dataset.matchIds || "")
            .split(",")
            .map((id) => id.trim())
            .filter(Boolean);
          const fixtures = matchIds.length > 0
            ? phaseBlock.matches.filter((fixture) => matchIds.includes(fixture.id))
            : phaseBlock.matches;

          const side = container.dataset.bracketSide || "left";
          container.innerHTML = fixtures
            .map((fixture, index) => {
              const baseMatch = matchesById.get(fixture.id);
              const displayMatch = displayMatchesById.get(fixture.id) || baseMatch;
              return renderMatch(displayMatch, (draftPredictions?.get(fixture.id) || predictionsById.get(fixture.id)), isMatchEditable(baseMatch), phase, getBracketSlot(index, fixtures.length, side, container.dataset.centerIndex));
            })
            .join("");
        });
      });

      document.querySelectorAll("[data-match-score]").forEach((input) => {
        input.addEventListener("input", () => {
          updatePenaltiesVisibility(input.dataset.matchScore);
          rerenderFromDraft(`[data-match-score="${input.dataset.matchScore}"][data-side="${input.dataset.side}"]`);
        });
      });

      document.querySelectorAll('[data-match-penalties] input[type="radio"]').forEach((input) => {
        input.addEventListener("change", () => {
          const matchId = input.name.replace("pens-", "");
          rerenderFromDraft(`input[name="pens-${matchId}"][value="${input.value}"]`);
        });
      });

      document.querySelectorAll('[data-phase-save="all"]').forEach((saveButton) => {
        saveButton.disabled = !hasEditablePhase();
      });
    }

    function collectPhasePredictions(phase) {
      const phaseBlock = phasesData.find((item) => item.phase === phase);
      if (!phaseBlock) return [];

      return phaseBlock.matches.map((fixture) => {
        if (!isMatchEditable(matchesById.get(fixture.id))) return null;

        const homeInput = document.querySelector(`[data-match-score="${fixture.id}"][data-side="home"]`);
        const awayInput = document.querySelector(`[data-match-score="${fixture.id}"][data-side="away"]`);
        const pensInput = document.querySelector(`input[name="pens-${fixture.id}"]:checked`);
        if (!homeInput || !awayInput || homeInput.value === "" || awayInput.value === "") {
          return null;
        }

        const homeScore = Number.parseInt(homeInput.value, 10);
        const awayScore = Number.parseInt(awayInput.value, 10);
        return {
          match_id: fixture.id,
          home_score: homeScore,
          away_score: awayScore,
          penalties_winner: homeScore === awayScore ? pensInput?.value ?? null : null,
        };
      }).filter(Boolean);
    }

    async function savePhase() {
      const buttons = Array.from(document.querySelectorAll('[data-phase-save="all"]'));
      buttons.forEach((button) => {
        button.disabled = true;
        button.dataset.saving = "true";
      });
      setBracketStatus("Guardando llave...", "loading");
      try {
        const phasesToSave = phasesData
          .map((phaseBlock) => phaseBlock.phase)
          .filter((phaseName) => {
            const phaseBlock = phasesData.find((item) => item.phase === phaseName);
            return phaseBlock?.matches.some((fixture) => isMatchEditable(matchesById.get(fixture.id)));
          });

        let savedRows = 0;
        const savedPhases = [];

        for (const editablePhase of phasesToSave) {
          const phaseRows = collectPhasePredictions(editablePhase);
          const response = await fetch("/api/bracket/predictions", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ phase: editablePhase, player_id: currentPlayerKey, predictions: phaseRows }),
          });
          const data = await response.json();
          if (!data.ok) {
            const prefix = savedPhases.length > 0
              ? `Se guardó ${savedPhases.join(", ")}, pero `
              : "";
            setBracketStatus(`${prefix}${data.error || "no se pudo guardar la llave."}`, "error");
            return;
          }

          savedRows += Number(data.saved) || 0;
          if (phaseRows.length > 0) {
            savedPhases.push(editablePhase);
          }
        }

        await loadBracket({ preserveDraft: true });
        const savedPhasesLabel = savedPhases.length > 0 ? savedPhases.join(", ") : "las rondas habilitadas";
        setBracketStatus(`Listo: ${savedRows} pronóstico${savedRows === 1 ? "" : "s"} guardado${savedRows === 1 ? "" : "s"} en ${savedPhasesLabel}.`, "success");
      } catch {
        setBracketStatus("Error de red al guardar la llave.", "error");
      } finally {
        buttons.forEach((button) => {
          button.dataset.saving = "false";
          button.disabled = !hasEditablePhase();
        });
      }
    }

    async function loadBracket(options = {}) {
      const { preserveDraft = false, silentErrors = false } = options;
      if (bracketLoadInFlight) return bracketLoadInFlight;

      const draft = preserveDraft ? captureDraftPredictions() : null;

      bracketLoadInFlight = (async () => {
        const response = await fetch(`/api/bracket/bootstrap?player_id=${encodeURIComponent(currentPlayerKey)}`, { cache: "no-store" });
        const data = await response.json();
        if (!data.ok) {
          if (!silentErrors) {
            setBracketStatus(data.error || "No se pudo cargar la llave", "error");
          }
          throw new Error(data.error || "No se pudo cargar la llave");
        }

        currentServerPlayer = data.player;
        matchesById = new Map((data.matches || []).map((match) => [match.id, match]));
        predictionsById = new Map((data.predictions || []).map((prediction) => [prediction.match_id, prediction]));
        refreshEveryMs = Number.isFinite(data.refreshEveryMs) ? data.refreshEveryMs : refreshEveryMs;

        if (playerNameDisplay) playerNameDisplay.textContent = currentServerPlayer?.name || "Jugador registrado";
        if (playerFavDisplay) playerFavDisplay.textContent = currentServerPlayer?.favorite_team ? `Favorito: ${currentServerPlayer.favorite_team}` : "Sin favorito cargado";

        render(draft);
        if (draft) restoreDraftPredictions(draft);
        scheduleBracketRefresh();
      })().finally(() => {
        bracketLoadInFlight = null;
      });

      return bracketLoadInFlight;
    }

    async function init() {
      currentPlayerKey = getPlayerId();
      try {
        const sessionRes = await fetch("/api/auth/session", { cache: "no-store" });
        const sessionData = await sessionRes.json();
        if (!sessionData.ok || !sessionData.user) {
          if (authGate) authGate.style.display = "";
          return;
        }

        if (workspaceSection) workspaceSection.style.display = "";
        await loadBracket();

        document.querySelectorAll("[data-bracket-jump]").forEach((button) => {
          button.addEventListener("click", () => {
            const target = document.querySelector(`[data-phase-panel="${button.dataset.bracketJump}"]`);
            target?.scrollIntoView({ behavior: "smooth", inline: "start", block: "nearest" });
          });
        });

        document.querySelectorAll("[data-phase-save]").forEach((button) => {
          button.addEventListener("click", () => savePhase());
        });
      } catch {
        if (authGate) authGate.style.display = "";
      }
    }

    init();
  </script>
</Layout>
