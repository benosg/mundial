---
import Layout from "../layouts/Layout.astro";
import { knockoutFixturesByPhase, knockoutPhaseOrder } from "../data/knockout";

const bracketColumns = {
  left: [
    { phase: "16avos", label: "16avos 1-8", matchIds: ["73", "74", "75", "76", "77", "78", "79", "80"] },
    { phase: "8vos", label: "8vos 1-4", matchIds: ["89", "90", "91", "92"] },
    { phase: "4tos", label: "4tos 1-2", matchIds: ["97", "98"] },
    { phase: "semis", label: "Semi 1", matchIds: ["101"] },
  ],
  center: [
    { phase: "final", label: "Final", matchIds: ["104"] },
    { phase: "3er/4to lugar", label: "3er y 4to lugar", matchIds: ["103"] },
  ],
  right: [
    { phase: "semis", label: "Semi 2", matchIds: ["102"] },
    { phase: "4tos", label: "4tos 3-4", matchIds: ["99", "100"] },
    { phase: "8vos", label: "8vos 5-8", matchIds: ["93", "94", "95", "96"] },
    { phase: "16avos", label: "16avos 9-16", matchIds: ["81", "82", "83", "84", "85", "86", "87", "88"] },
  ],
} as const;
const phasesJson = JSON.stringify(knockoutFixturesByPhase).replace(/</g, "\\u003c");
---

<Layout
  title="Llaves"
  currentPath="/bracket"
  description="Pronósticos del cuadro eliminatorio del Mundial 2026, fase por fase y con definición por penales cuando corresponde."
>
  <div class="simple-main bracket-page">
    <section class="simple-top" aria-labelledby="bracket-title">
      <div class="site-shell simple-stack">
        <div class="hero-copy-block bracket-hero-copy">
          <span class="eyebrow">Cuadro eliminatorio</span>
          <h1 class="simple-title" id="bracket-title">Pronóstico de llaves</h1>
          <p class="section-copy section-copy-tight">Arma tu cuadro fase por fase en un formato horizontal clásico. La llave mantiene los bloqueos por horario, edición de marcadores y definición por penales cuando hay empate.</p>
        </div>

        <div class="hero-badges bracket-hero-badges" aria-label="Aspectos clave de la llave">
          <span class="hero-badge">Desliza por fases</span>
          <span class="hero-badge">Guarda cada columna</span>
          <span class="hero-badge">Penales obligatorios en empates</span>
        </div>

        <div class="summary-grid">
          <article class="summary-box highlight">
            <div class="muted">Jugador</div>
            <strong data-player-name-display>Inicia sesión para jugar</strong>
            <span data-player-fav-display class="muted">Elige fase por fase y define penales en los empates</span>
          </article>
          <article class="summary-box">
            <div class="muted">Fases</div>
            <strong>{knockoutPhaseOrder.length}</strong>
          </article>
          <article class="summary-box">
            <div class="muted">Partidos</div>
            <strong>32</strong>
          </article>
          <article class="summary-box">
            <div class="muted">Modo</div>
            <strong>Cuadro separado</strong>
          </article>
        </div>
      </div>
    </section>

    <section class="page-section simple-section" data-auth-gate style="display:none">
      <div class="site-shell">
        <article class="panel auth-gate-panel">
          <div class="auth-gate-inner">
            <span class="eyebrow">Acceso requerido</span>
            <h2 class="section-title">Inicia sesión para guardar tu llave</h2>
            <p class="muted" style="margin-bottom:1.2rem">Necesitás una cuenta de Google para persistir tus pronósticos fase por fase.</p>
            <a class="button" href="/api/auth/signin">Iniciar sesión con Google</a>
          </div>
        </article>
      </div>
    </section>

    <section class="page-section simple-section workspace-section" data-workspace-section style="display:none">
      <div class="site-shell bracket-layout">
        <article class="panel bracket-board-panel">
          <div class="bracket-board-header">
            <div>
              <span class="eyebrow">Llave completa</span>
              <h2 class="section-title section-title-compact">Vista clásica de llaves</h2>
              <p class="muted bracket-board-copy">Los cruces avanzan desde ambos lados hacia el centro. Cada fase se habilita cuando finaliza la anterior.</p>
            </div>

            <div class="bracket-phase-nav" aria-label="Ir a una fase del cuadro">
              {knockoutFixturesByPhase.map((phase) => (
                <button class="button-secondary bracket-phase-nav-button" type="button" data-bracket-jump={phase.phase}>{phase.label}</button>
              ))}
            </div>

            <div class="bracket-save-row" aria-label="Guardar pronosticos por fase">
              <button class="button button-compact bracket-save-button" type="button" data-phase-save="16avos">Guardar 16avos</button>
              <button class="button button-compact bracket-save-button" type="button" data-phase-save="8vos">Guardar 8vos</button>
              <button class="button button-compact bracket-save-button" type="button" data-phase-save="4tos">Guardar 4tos</button>
              <button class="button button-compact bracket-save-button" type="button" data-phase-save="semis">Guardar semis</button>
              <button class="button button-compact bracket-save-button" type="button" data-phase-save="3er/4to lugar">Guardar 3er/4to lugar</button>
              <button class="button button-compact bracket-save-button" type="button" data-phase-save="final">Guardar final</button>
            </div>
            <p class="save-status" data-bracket-save-status role="status"></p>
          </div>

          <div class="bracket-scroll-shell" data-bracket-scroll-shell tabindex="0">
            <div class="bracket-board" data-bracket-board>
              <div class="bracket-wing bracket-wing--left" aria-label="Lado izquierdo de la llave">
                {bracketColumns.left.map((column, index) => (
                  <section class="bracket-phase-panel bracket-phase-panel--split" data-phase-panel={column.phase} data-bracket-side="left" data-bracket-depth={index} id={`bracket-column-left-${column.phase.replaceAll("/", "-").replaceAll(" ", "-")}-${index}`}>
                    <div class="bracket-phase-head">
                      <div>
                        <span class="eyebrow">Fase eliminatoria</span>
                        <h2 class="entry-title">{column.label}</h2>
                      </div>
                    </div>

                    <div class="bracket-match-list" data-phase-matches={column.phase} data-match-ids={column.matchIds.join(",")} data-bracket-side="left" data-bracket-depth={index}></div>
                  </section>
                ))}
              </div>

              <div class="bracket-center" aria-label="Finales de la llave">
                {bracketColumns.center.map((column, index) => (
                  <section class="bracket-phase-panel bracket-phase-panel--center" data-phase-panel={column.phase} data-bracket-side="center" data-center-index={index} id={`bracket-column-center-${index}`}>
                    <div class="bracket-phase-head">
                      <div>
                        <span class="eyebrow">Centro</span>
                        <h2 class="entry-title">{column.label}</h2>
                      </div>
                    </div>

                    <div class="bracket-match-list" data-phase-matches={column.phase} data-match-ids={column.matchIds.join(",")} data-bracket-side="center" data-center-index={index}></div>
                  </section>
                ))}
              </div>

              <div class="bracket-wing bracket-wing--right" aria-label="Lado derecho de la llave">
                {bracketColumns.right.map((column, index) => (
                  <section class="bracket-phase-panel bracket-phase-panel--split" data-phase-panel={column.phase} data-bracket-side="right" data-bracket-depth={index} id={`bracket-column-right-${column.phase.replaceAll("/", "-").replaceAll(" ", "-")}-${index}`}>
                    <div class="bracket-phase-head">
                      <div>
                        <span class="eyebrow">Fase eliminatoria</span>
                        <h2 class="entry-title">{column.label}</h2>
                      </div>
                    </div>

                    <div class="bracket-match-list" data-phase-matches={column.phase} data-match-ids={column.matchIds.join(",")} data-bracket-side="right" data-bracket-depth={index}></div>
                  </section>
                ))}
              </div>
            </div>
          </div>
        </article>

        <div class="workspace-column workspace-sidebar-stack bracket-sidebar-stack">
          <article class="panel compact-panel workspace-rules">
            <span class="eyebrow">Reglas del cuadro</span>
            <h2 class="section-title section-title-compact">Cómo puntúa la llave</h2>

            <div class="rules-highlight">
              <ul>
                <li><strong>5 puntos</strong> por acertar marcador exacto.</li>
                <li><strong>3 puntos</strong> por acertar el ganador del cruce.</li>
                <li><strong>0 puntos</strong> si el ganador no coincide.</li>
                <li>Si pronosticas <strong>empate</strong>, debes elegir ganador por <strong>penales</strong>.</li>
                <li>En empates reales, el exacto exige <strong>marcador exacto + penales correctos</strong>.</li>
              </ul>
            </div>

            <p class="fair-note">Cada fase abre cuando termina la anterior y se bloquea una hora antes del primer partido de esa fase. Los puntos de la llave se suman al ranking general.</p>

            <div class="inline-actions">
              <a class="button-secondary" href="/groups">Ver fase de grupos</a>
              <a class="button-secondary" href="/companions">Ver ranking</a>
            </div>
          </article>
        </div>
      </div>
    </section>
  </div>

  <script id="knockout-phases-json" type="application/json" is:inline set:html={phasesJson}></script>

  <script is:inline>
    const phasesData = JSON.parse(document.getElementById("knockout-phases-json")?.textContent || "[]");
    const STORAGE_KEY = "mundial-2026-player-id";
    const authGate = document.querySelector("[data-auth-gate]");
    const workspaceSection = document.querySelector("[data-workspace-section]");
    const playerNameDisplay = document.querySelector("[data-player-name-display]");
    const playerFavDisplay = document.querySelector("[data-player-fav-display]");
    const bracketSaveStatus = document.querySelector("[data-bracket-save-status]");
    let currentPlayerKey = null;
    let currentServerPlayer = null;
    let matchesById = new Map();
    let predictionsById = new Map();
    let phaseStates = {};

    function getPlayerId() {
      let id = localStorage.getItem(STORAGE_KEY);
      if (!id) {
        id = crypto.randomUUID();
        localStorage.setItem(STORAGE_KEY, id);
      }
      return id;
    }

    function escapeHtml(value) {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#39;");
    }

    function formatChileDate(iso) {
      return new Intl.DateTimeFormat("es-CL", {
        timeZone: "Etc/GMT+4",
        day: "2-digit",
        month: "short",
        hour: "2-digit",
        minute: "2-digit",
        hour12: false,
      }).format(new Date(iso)).replace(",", " ·");
    }

    function phaseClassName(phase) {
      return phase
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replaceAll("/", "-")
        .replaceAll(" ", "-")
        .toLowerCase();
    }

    function getBracketSlot(index, total, side, centerIndex) {
      if (side === "center") {
        return { start: centerIndex === "1" ? 10 : 7, span: 3 };
      }

      const span = Math.max(2, 16 / total);
      return { start: Math.round(index * span) + 1, span };
    }

    function setBracketStatus(message, state = "") {
      if (!bracketSaveStatus) return;
      bracketSaveStatus.textContent = message;
      bracketSaveStatus.dataset.state = state;
    }

    function renderMatch(match, prediction, editable, phase, slot) {
      const homeValue = Number.isInteger(prediction?.home_score) ? prediction.home_score : "";
      const awayValue = Number.isInteger(prediction?.away_score) ? prediction.away_score : "";
      const needsPens = prediction && prediction.home_score === prediction.away_score;
      const showPens = needsPens || (match.home_result !== null && match.home_result === match.away_result);
      const classes = [
        "bracket-match-card",
        `bracket-match-card--${phaseClassName(phase)}`,
      ].filter(Boolean).join(" ");
      const actualResult = match.home_result !== null && match.away_result !== null
        ? `<div class="bracket-result-note muted small-note">Real: ${match.home_result}-${match.away_result}${match.home_result === match.away_result && match.penalties_winner ? ` · penales ${match.penalties_winner === 'home' ? escapeHtml(match.home_team) : escapeHtml(match.away_team)}` : ""}</div>`
        : "";
      const broadcasters = Array.isArray(match.broadcasters) && match.broadcasters.length > 0
        ? `<div class="bracket-broadcasters muted small-note">${escapeHtml(match.broadcasters.join(" · "))}</div>`
        : "";

      return `
        <div class="bracket-match-slot" style="--slot-start:${slot.start}; --slot-span:${slot.span}">
        <article class="${classes}" data-match-card="${match.id}">
          <div class="bracket-match-top">
            <span class="tag bracket-match-tag">${escapeHtml(match.label)}</span>
            <div class="muted small-note bracket-match-meta">${formatChileDate(match.kickoff_at)} · ${escapeHtml(match.city)}</div>
          </div>

          <div class="bracket-match-subhead muted small-note">${escapeHtml(match.venue)}, ${escapeHtml(match.city)}</div>
          ${broadcasters}

          <div class="bracket-teams-grid">
            <div class="bracket-team-row">
              <div class="bracket-team-copy">
                <span class="bracket-slot">${escapeHtml(match.home_slot)}</span>
                <strong class="bracket-team-name">${escapeHtml(match.home_team)}</strong>
              </div>
              <div class="bracket-score-inputs">
                <input type="number" min="0" max="20" inputmode="numeric" data-match-score="${match.id}" data-side="home" value="${homeValue}" ${editable ? "" : "disabled"} />
              </div>
            </div>
            <div class="bracket-team-row">
              <div class="bracket-team-copy">
                <span class="bracket-slot">${escapeHtml(match.away_slot)}</span>
                <strong class="bracket-team-name">${escapeHtml(match.away_team)}</strong>
              </div>
              <div class="bracket-score-inputs">
                <input type="number" min="0" max="20" inputmode="numeric" data-match-score="${match.id}" data-side="away" value="${awayValue}" ${editable ? "" : "disabled"} />
              </div>
            </div>
          </div>

          <div class="bracket-penalties" data-match-penalties="${match.id}" style="display:${showPens ? "grid" : "none"}">
            <span class="muted">Penales si termina empate:</span>
            <label><input type="radio" name="pens-${match.id}" value="home" ${prediction?.penalties_winner === "home" ? "checked" : ""} ${editable ? "" : "disabled"} /> ${escapeHtml(match.home_team)}</label>
            <label><input type="radio" name="pens-${match.id}" value="away" ${prediction?.penalties_winner === "away" ? "checked" : ""} ${editable ? "" : "disabled"} /> ${escapeHtml(match.away_team)}</label>
          </div>

          ${actualResult}
        </article>
        </div>`;
    }

    function updatePenaltiesVisibility(matchId) {
      const homeInput = document.querySelector(`[data-match-score="${matchId}"][data-side="home"]`);
      const awayInput = document.querySelector(`[data-match-score="${matchId}"][data-side="away"]`);
      const penalties = document.querySelector(`[data-match-penalties="${matchId}"]`);
      if (!homeInput || !awayInput || !penalties) return;
      const show = homeInput.value !== "" && awayInput.value !== "" && homeInput.value === awayInput.value;
      penalties.style.display = show ? "grid" : "none";
      if (!show) {
        penalties.querySelectorAll('input[type="radio"]').forEach((input) => { input.checked = false; });
      }
    }

    function render() {
      phasesData.forEach((phaseBlock) => {
        const phase = phaseBlock.phase;
        const state = phaseStates[phase];
        const editable = !!state?.editable;
        document.querySelectorAll(`[data-phase-save="${phase}"]`).forEach((saveButton) => {
          saveButton.disabled = !editable;
        });

        document.querySelectorAll(`[data-phase-matches="${phase}"]`).forEach((container) => {
          const matchIds = (container.dataset.matchIds || "")
            .split(",")
            .map((id) => id.trim())
            .filter(Boolean);
          const fixtures = matchIds.length > 0
            ? phaseBlock.matches.filter((fixture) => matchIds.includes(fixture.id))
            : phaseBlock.matches;

          const side = container.dataset.bracketSide || "left";
          container.innerHTML = fixtures
            .map((fixture, index) => renderMatch(matchesById.get(fixture.id), predictionsById.get(fixture.id), editable, phase, getBracketSlot(index, fixtures.length, side, container.dataset.centerIndex)))
            .join("");
        });
      });

      document.querySelectorAll("[data-match-score]").forEach((input) => {
        input.addEventListener("input", () => updatePenaltiesVisibility(input.dataset.matchScore));
      });
    }

    function collectPhasePredictions(phase) {
      const phaseBlock = phasesData.find((item) => item.phase === phase);
      if (!phaseBlock) return [];

      return phaseBlock.matches.map((fixture) => {
        const homeInput = document.querySelector(`[data-match-score="${fixture.id}"][data-side="home"]`);
        const awayInput = document.querySelector(`[data-match-score="${fixture.id}"][data-side="away"]`);
        const pensInput = document.querySelector(`input[name="pens-${fixture.id}"]:checked`);
        if (!homeInput || !awayInput || homeInput.value === "" || awayInput.value === "") {
          return null;
        }

        const homeScore = Number.parseInt(homeInput.value, 10);
        const awayScore = Number.parseInt(awayInput.value, 10);
        return {
          match_id: fixture.id,
          home_score: homeScore,
          away_score: awayScore,
          penalties_winner: homeScore === awayScore ? pensInput?.value ?? null : null,
        };
      }).filter(Boolean);
    }

    async function savePhase(phase) {
      const rows = collectPhasePredictions(phase);
      const buttons = Array.from(document.querySelectorAll(`[data-phase-save="${phase}"]`));
      buttons.forEach((button) => {
        button.disabled = true;
        button.dataset.saving = "true";
      });
      setBracketStatus(`Guardando ${phase}...`, "loading");
      try {
        const response = await fetch("/api/bracket/predictions", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ phase, player_id: currentPlayerKey, predictions: rows }),
        });
        const data = await response.json();
        if (!data.ok) {
          setBracketStatus(data.error || "No se pudo guardar esta fase.", "error");
          return;
        }
        await loadBracket();
        setBracketStatus(`Listo: ${data.saved} pronóstico${data.saved === 1 ? "" : "s"} guardado${data.saved === 1 ? "" : "s"} en ${phase}.`, "success");
      } catch {
        setBracketStatus("Error de red al guardar la llave.", "error");
      } finally {
        buttons.forEach((button) => {
          button.dataset.saving = "false";
          const state = phaseStates[phase];
          button.disabled = !state?.editable;
        });
      }
    }

    async function loadBracket() {
      const response = await fetch(`/api/bracket/bootstrap?player_id=${encodeURIComponent(currentPlayerKey)}`, { cache: "no-store" });
      const data = await response.json();
      if (!data.ok) {
        setBracketStatus(data.error || "No se pudo cargar la llave", "error");
        throw new Error(data.error || "No se pudo cargar la llave");
      }

      currentServerPlayer = data.player;
      matchesById = new Map((data.matches || []).map((match) => [match.id, match]));
      predictionsById = new Map((data.predictions || []).map((prediction) => [prediction.match_id, prediction]));
      phaseStates = data.phaseStates || {};

      if (playerNameDisplay) playerNameDisplay.textContent = currentServerPlayer?.name || "Jugador registrado";
      if (playerFavDisplay) playerFavDisplay.textContent = currentServerPlayer?.favorite_team ? `Favorito: ${currentServerPlayer.favorite_team}` : "Sin favorito cargado";

      render();
    }

    async function init() {
      currentPlayerKey = getPlayerId();
      try {
        const sessionRes = await fetch("/api/auth/session", { cache: "no-store" });
        const sessionData = await sessionRes.json();
        if (!sessionData.ok || !sessionData.user) {
          if (authGate) authGate.style.display = "";
          return;
        }

        if (workspaceSection) workspaceSection.style.display = "";
        await loadBracket();

        document.querySelectorAll("[data-bracket-jump]").forEach((button) => {
          button.addEventListener("click", () => {
            const target = document.querySelector(`[data-phase-panel="${button.dataset.bracketJump}"]`);
            target?.scrollIntoView({ behavior: "smooth", inline: "start", block: "nearest" });
          });
        });

        document.querySelectorAll("[data-phase-save]").forEach((button) => {
          button.addEventListener("click", () => savePhase(button.dataset.phaseSave));
        });
      } catch {
        if (authGate) authGate.style.display = "";
      }
    }

    init();
  </script>
</Layout>
